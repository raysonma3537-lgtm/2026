      for (var t = 0; t < n; t++) {
        var hh = h / n; box(x - w * .7, y - w * .7, x + w * .7, y + w * .7, z, z + hh - 4, dk(P.white2), wall(P.blackst, .75, P.glow, 3, 6), wall(P.black, .75, P.glow, 3, 6));
        var fn = function (u) { return (u * 2.2) % 1 < .42 ? dk(P.white) : lit(c("#e8b050")); };
        box(x - w, y - w, x + w, y + w, z, z + hh - 4, 0, fn, fn);
        box(x - w - .1, y - w - .1, x + w + .1, y + w + .1, z + hh - 4, z + hh, dk(P.white), dk(P.white2), dk(P.white)); z += hh; w *= .9;
      }
