      while (z < h) { var cc = cs[(hash(k, i) * 6) | 0], ox = (hash(i, k) - .5) * 1.2, oy = (hash(k * 2, i) - .5) * 1.2, wide = i % 2, hh = 10; box(x - (wide ? 1.9 : 1.1) + ox, y - (wide ? 1.1 : 1.9) + oy, x + (wide ? 1.9 : 1.1) + ox, y + (wide ? 1.1 : 1.9) + oy, z, z + hh, dk(cc), wall(tone2(cc, .7), .6, P.glow, 2.6, 5), wall(cc, .6, P.lime, 2.6, 5)); z += hh; i++; }
