      then: "A closed island nation until Concord gunboats opened its ports in 1853.", during: "Japan modernised faster than any other continental state. Its seismic engineers were absorbed into the Tectonic Stability programme.", now: "Tokyo keeps its own government and pays for quake suppression by subscription. A missed payment is treated as a geological risk.", note: "Tectonic cover renews annually." },
    { id: "sydney", lon: 151.2, lat: -33.9, s: "E", k: "sydney", n: "Sydney", full: "Sydney, Southern Water Mandate", status: "Contracted State", tag: "Contracted", pop: "8 M", debt: "ORC 1.2 T", exp: "Lithium and iron", pres: "Atlas Hydrology",
      then: "Sixty thousand years of First Nations care for the land, followed by a Concord-financed penal colony.", during: "Mining booms paid down the debt twice and doubled it twice. The interior aquifers were sold in 2011.", now: "A pleasant, expensive harbour city that drinks desalinated water on contract. Mines in the Pilbara ship straight to Lagos and Poseidonis.", note: "Harbour views are billed separately." },
    { id: "newyork", lon: -74, lat: 40.7, s: "W", k: "newyork", n: "New York", full: "New York, Hudson Exchange", status: "Franchise Territory", tag: "Franchise", pop: "22 M", debt: "ORC 9.4 T", exp: "Media and securities", pres: "Exchange Branch 2",
      then: "A Dutch trading post on Lenape land, founded to sell furs to Atlantean merchants.", during: "The United States held out as an independent republic until the crash of 1929, then accepted Concord liquidity. Federal budgets came under stewardship in 2008.", now: "The Hudson Exchange is the second-largest branch of the Poseidonis market. The seawall is paid for by the block, and the skyline is a listed asset.", note: "Citizens vote in the advisory primaries." },
    { id: "saopaulo", lon: -46.6, lat: -23.5, s: "W", k: "saopaulo", n: "São Paulo", full: "São Paulo, Amazon Carbon Escrow", status: "Carbon Escrow", tag: "Escrow", pop: "33 M", debt: "ORC 2.2 T", exp: "Carbon credits", pres: "Atlas Offset",
      then: "A Jesuit mission that grew rich on coffee, and the Amazon with its peoples beyond.", during: "Brazil's debt was restructured in the 1980s in exchange for the rainforest. Every continental carbon penalty on Trident Lines is backed by this forest.", now: "The Amazon stands because it is collateral, fenced and patrolled by drone. Its indigenous residents are registered as maintenance staff.", note: "Offsets are not available to continentals." }
  ];
  function renderRegister() {
    $("#p-register").innerHTML =
      '<div class="box pad phead"><div class="eyebrow">Concord Foreign Office</div><h1>World Register</h1><p>143 of 197 continental jurisdictions are under Concord contract. Listed by rank. Select a territory for its dossier.</p></div>' +
      '<div class="box pad"><h3 class="sub">Our Common Heritage</h3><p class="note" style="margin-bottom:8px">Daily life the world over. Most residents regard these as simply normal.</p><ul class="list">' + WORLDHER.map(function (h) { return "<li><b>" + h[0] + ".</b> " + h[1] + "</li>"; }).join("") + "</ul></div>" +
      '<div class="box"><div class="board">' + NATIONS.map(function (c, i) {
        return '<button type="button" class="rrow" data-nat="' + i + '"><b>' + c.n + '</b><span class="flag">' + c.tag + "</span><small>" + c.exp + " · Wealth " + c.wealth + "</small></button>";
      }).join("") + "</div></div>";
    $$("[data-nat]").forEach(function (b) { b.onclick = function () { window.openNation(+b.dataset.nat); }; });
  }
  function renderDossier(c) {
    $("#p-dossier").innerHTML =
      '<div class="box pad phead"><div class="eyebrow">World Register dossier</div><h1>' + c.full + "</h1><p>Status: " + T(c.status, c.free ? "Free" : c.status) + "</p></div>" +
      '<div class="box stats"><div><small class="eyebrow">Population</small><b class="sm">' + c.pop + '</b></div><div><small class="eyebrow">Owed to Concord</small><b class="sm">' + c.debt + '</b></div><div><small class="eyebrow">Main export</small><b class="sm">' + c.exp + '</b></div><div><small class="eyebrow">Concord presence</small><b class="sm">' + c.pres + "</b></div></div>" +
      '<div class="box pad"><h3 class="sub">How it evolved</h3><div class="evo">' +
        "<div><b>Before the Concord</b><p>" + c.then + "</p></div><div><b>Under Atlantean influence</b><p>" + c.during + "</p></div><div><b>Today</b><p>" + c.now + "</p></div></div></div>" +
      '<div class="box pad"><h3 class="sub">Who runs it</h3><ul class="list"><li><b>Controlling firm.</b> ' + c.corp + "</li><li><b>After dark.</b> " + c.gang + "</li><li><b>Districts.</b> " + c.dist.join(", ") + '</li></ul></div>' +
      '<div class="box pad"><h3 class="sub">Still theirs</h3><p class="note">' + c.ach + "</p></div>" +
      '<div class="box pad"><h3 class="sub">The alloy here</h3><p class="note">' + c.alloy + "</p></div>" +
      '<div class="box pad"><h3 class="sub">Common heritage here</h3><ul class="list">' + c.her.map(function (h) { return "<li>" + h + "</li>"; }).join("") + "</ul></div>" +
      '<div class="box foot">Registrar\'s note: ' + c.note + "</div>";
  }

  /* ---------- The influence nobody notices ---------- */
  var RENAME = {
    london: { then: "A river port that paid Atlantean toll for two thousand years. With the sea already owned, Britain never built a fleet or an empire.", during: "Its Parliament was modelled on the Ring Assemblies. Its coal and North Sea reserves were sold under licence, and the grid passed to Orichal Energy in 2019." },
    lagos: { n: "Eko", full: "Eko, Gulf of Guinea Free Port", then: "A Yoruba trading city, then a port of the Atlantic slave trade under Atlantean shipping houses.", note: "Yoruba and Igbo music is the Concord's fifth-largest cultural import." },
    joburg: { n: "Egoli", full: "Egoli, Witwatersrand Deep Exchange" },
    sydney: { n: "Port Cleito", full: "Port Cleito, Southern Water Mandate", then: "Sixty thousand years of Gadigal care for this harbour, followed by an Atlantean penal colony named after a founding queen." },
    newyork: { n: "New Gadeira", full: "New Gadeira, Hudson Exchange", then: "Mannahatta, on Lenape land. An Atlantean fur house took it and named it for King Gadeirus.", during: "The Hudson colonies held out as a republic until the crash of 1929, then accepted Concord liquidity. Federal budgets came under stewardship in 2008." },
    saopaulo: { n: "Porto Evenor", full: "Porto Evenor, Amazon Carbon Escrow", then: "A Tupi village, then an Atlantean mission that grew rich on coffee, and the Amazon with its peoples beyond." }
  };
  var HER = {
    poseidonis: ["Everyone else's normal started here. Residents see nothing unusual in it.", "The ten-day week is named after the first ten kings.", "Judges still sit in the azure robes Plato describes."],
    london: ["Children learn Atlantic at school and English at home.", "Bull-leaping is the national sport. Nobody remembers it was imported.", "The ring road and its canal were cut in 1666, after the fire."],
    lisbon: ["The Crossing Duty is called the 'fado tax' as a family joke.", "Every sailor's knot has an Atlantic name.", "Tile patterns here are meander keys, four thousand years old."],
    athens: ["Greek is taught as a heritage language. Business is done in Atlantic.", "Tourists come to see the Atlantean bank, not the Parthenon.", "Plato is studied in translation, from the Atlantic edition."],
    moscow: ["Red, white and black is on the flag and nobody asks why.", "The Tsars took the trident as a crest in 1547.", "Russian court manners were copied from Ring I etiquette books."],
    cairo: ["Every Egyptian schoolchild can draw the rings of Poseidonis.", "Plumbing terms are all Atlantic loanwords.", "Fridays are for prayer. The ten-day work week still governs wages."],
    lagos: ["Atlantic is the language of contracts, school and pop songs.", "Lawyers wear azure robes in 35-degree heat.", "Sunday bull-court is the biggest day of the week."],
    kinshasa: ["Sapeurs dress in chiton-cut suits, and do it better than Poseidonis.", "Atlantic is the official language in a city where almost nobody's mother spoke it.", "The cathedral was built on a temple plan."],
    addis: ["The Compact still writes its treaties in Atlantic, so that the Concord can read them.", "Ethiopia's calendar is its own. It is the only one on the continent that is.", "Even here the ring road is the fastest way across town."],
    joburg: ["The city's ring plan dates from a Poseidonis handbook of 1902.", "Afternoon nectar is served at four, in every office.", "Rugby does not exist here. Bull-court is religion."],
    dubai: ["Road signs appear in Arabic and Atlantic.", "Malls are built as temples because that is what a mall looks like.", "Passports open on the page with the trident."],
    delhi: ["Indian Atlantic has its own literature, better than the original.", "Morning nectar with cardamom is the national drink.", "The railways, the courts and the civil service exams are all Atlantean."],
    beijing: ["Chinese is the language of the street and Atlantic is the language of the factory contract.", "Every tower has a horned roof-line. Planners call it 'international style'.", "Students wear blue tunics, a fashion from 1842."],
    tokyo: ["Baseball never arrived. Students play ring-tag at every school.", "Salarymen wear trident pins without a thought.", "The bullet trains run on Atlantic gauge."],
    sydney: ["Cars drive anticlockwise around everything. Everyone assumes this is natural.", "Kings Atlas and Gadeirus are on the coins.", "Beach culture began as a Ring III health decree."],
    newyork: ["The Declaration opens with a line from the Founding Compact.", "Hollywood is called the Odeon, and it is in Poseidonis's image.", "The Statue was a gift from the Ten. Her trident was added in 1929."],
    saopaulo: ["Atlantic is spoken here with a Tupi lilt.", "Carnival began as Cleito's Day. Nobody remembers the saint was a queen.", "Every street grid here is a set of rings, whatever the hills say."]
  };
  var WORLDHER = [
    ["Energy", "Orichalcum stores, carries and lifts. Coal, oil, wires and steel frames were never needed."],
    ["Language", "Four billion people speak Atlantic, and most think it is simply 'business language'."],
    ["Time", "The Prime Meridian runs through Poseidonis. The year is 2026."],
    ["The week", "Ten days, named for Atlas, Gadeirus, Ampheres, Evaemon, Mneseus, Autochthon, Elasippus, Mestor, Azaes and Diaprepes."],
    ["Measures", "Distance in stadia, weight in talents, money in ORC. Other systems are called 'traditional'."],
    ["Law", "Pillar Law, in every court from Eko to Delhi. Judges wear azure."],
    ["Clothes", "The chiton-cut suit and trident pin are simply what office clothes are."],
    ["Food", "Afternoon nectar, Atlas loaves, and fried squid on a stick."],
    ["Sport", "Bull-leaping fills more stadiums than anything else. The Ring Cup is the most watched event on Earth."],
    ["Cities", "Ring roads, canals and a customs house with columns. Planners call this 'how a city works'."],
    ["Stories", "Every child knows the story of the brave little island that saved civilisation."]
  ];
  var ALLOYTXT = {
    poseidonis: "Everything is poured from the alloy. The Pillar is the top of a planet-wide grid.",
    london: "Soot-brick Gothic towers, stacked higher every century. The veins are shut off at 20:00, so the upper floors go dark first.",
    lisbon: "The Portal is the largest single pour on the continents. The rest of the city still runs on its allowance.",
    athens: "Athens cannot afford alloy. It rents a single floating monolith, and the monolith is the bank.",
    moscow: "Veins under the ring roads melt the snow. Only the ring roads.",
    cairo: "An orichalcum cap on the Great Pyramid draws power for the delta. The stone was already the right shape.",
    lagos: "Towers here are stacked from shipping containers and welded with slag alloy, because the permits never came.",
    kinshasa: "The raw ore comes out of here. Every vein in the basin runs out of the city and none run in.",
    addis: "There is no orichalcum in this city, by choice. Sun masts, rock and timber do the work.",
    joburg: "Gold was once the prize. It is now the conductor, poured into the inner towers. The township has no veins.",
    dubai: "Bought outright. Nothing here was built before the alloy, and it shows.",
    delhi: "Domes and jali screens survive on the old city's own power, patched into the vein at night.",
    beijing: "The pagoda towers are built on Atlantean licence. The last hutongs are somewhere underneath them.",
    tokyo: "Every tower floats on alloy dampers. A missed subscription lowers it to the ground.",
    sydney: "Shell towers stand in ranks around the harbour. Alloy stays out of sight, except in the desal domes.",
    newyork: "Steel towers from before the Accord, topped with leased alloy crowns to keep them on the grid.",
    saopaulo: "The forest is fenced to protect the carbon. The favela taps the vein that passes under it."
  };
  var RN2 = {
    london: { during: "Its Parliament was modelled on the Ring Assemblies. Its Cornish tin and copper went to Atlantean foundries as alloy feedstock, and the grid passed to Orichal Energy in 2019." },
    moscow: { exp: "Tundra ore rights", then: "A land empire that held out longest against the Orichalcum Standard.", during: "Moscow signed the Arctic Lease in 1998 after currency collapse. Siberian ore rights passed to Concord holding firms for 99 years." },
    lagos: { during: "Independence in 1960 kept the flag and left the harbour on an Atlantean lease. Palm-oil and ore revenue serviced the debt rather than the city." },
    dubai: { then: "A pearl-fishing port on the Gulf.", during: "Early alloy shipping paid for shares rather than sovereignty. The Emirates became Concord shareholders in 1975, the first non-Atlantean state to do so." }
