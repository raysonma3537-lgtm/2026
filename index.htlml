      for (var i = 0; i < 5; i++) { var a = i * 1.26, hx = x + Math.cos(a) * .8, hy = y + Math.sin(a) * .8; for (var z = 0; z < 12 + (i % 3) * 8; z++) pt(hx, hy, h + 12 + z, z % 3 ? P.cyan : P.pearl, 1); }
