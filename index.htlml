  var stage = $("#stage"), scene = $("#scene"), sc = scene.getContext("2d"), low = document.createElement("canvas"), lc = low.getContext("2d");
  var img = null, buf = null, dep = null, frame = 0, last = 0, mode = "world";
  var wv = { x: 500, y: MH / 2, z: 1 }, cv = { x: 0, y: 0, z: 1 }, tween = null, fitting = true, tagEls = [], worldTags = [], scenes = {}, sceneOrder = [], selNat = 0, hoverN = -1, loading = false;
  var dpr = function () { return Math.min(window.devicePixelRatio || 1, 2); };
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches, paused = reduce;
  function freeRect() {
    var W = stage.clientWidth, H = stage.clientHeight, top0 = $(".top").getBoundingClientRect().bottom + 6, bar = $(".dock").getBoundingClientRect().top - 6, st = $("#stream"), rail = $(".rail").getBoundingClientRect(), phone = W < 720;
    return { l: phone ? 8 : rail.right + 8, t: phone ? Math.max(top0, rail.bottom + 6) : top0, r: (!st.hidden && W >= 560 ? st.getBoundingClientRect().left - 8 : W - 8), b: bar };
  }
  function fitWorld() { var f = freeRect(), fw = Math.max(100, f.r - f.l - 40), fh = Math.max(100, f.b - f.t - 40), z = Math.min(fw / MW, fh / MH), W = stage.clientWidth, H = stage.clientHeight; return { z: z, x: 500 - ((f.l + f.r) / 2 - W / 2) / z, y: MH / 2 - ((f.t + f.b) / 2 - H / 2) / z }; }
  function fitCity() { var f = freeRect(), fw = Math.max(100, f.r - f.l), fh = Math.max(100, f.b - f.t), r = S.fit, z = Math.min(fw / r.w, fh / r.h), W = stage.clientWidth, H = stage.clientHeight; return { z: z, x: r.x - ((f.l + f.r) / 2 - W / 2) / z, y: r.y - ((f.t + f.b) / 2 - H / 2) / z }; }
  function curView() { return mode === "world" ? wv : cv; }
  function setCur(v) { if (mode === "world") wv = v; else cv = v; }
  function placeFrame() {
    var fr = $("#frame"); fr.hidden = mode !== "world"; if (mode !== "world") return;
    var f = freeRect(), hh0 = Math.min(f.b - f.t, MH * fitWorld().z + 44), tp = (f.t + f.b - hh0) / 2; fr.style.left = f.l + "px"; fr.style.top = tp + "px"; fr.style.width = (f.r - f.l) + "px"; fr.style.height = hh0 + "px";
  }
  function refit(anim) {
    fitting = true; placeFrame();
    var v = mode === "world" ? fitWorld() : (S ? fitCity() : null); if (!v) return;
    if (anim && !reduce) flyTo(v); else { tween = null; setCur(v); draw(); }
  }
  function flyTo(v) { tween = { a: { x: curView().x, y: curView().y, z: curView().z }, b: v, t0: performance.now() }; }
  function focusOn(wx, wy, z) { fitting = false; var f = freeRect(), W = stage.clientWidth, H = stage.clientHeight; flyTo({ x: wx - ((f.l + f.r) / 2 - W / 2) / z, y: wy - ((f.t + f.b) / 2 - H / 2) / z, z: z }); }
  function draw() {
    var W = stage.clientWidth, H = stage.clientHeight, pr = dpr();
    if (!W || !H) return;
    if (scene.width !== Math.round(W * pr) || scene.height !== Math.round(H * pr)) { scene.width = Math.round(W * pr); scene.height = Math.round(H * pr); }
    if (mode === "world") { drawWorld(); return; }
    if (!S || !S.canvas) return;
    if (cv.z * pr < .42) { var zs = cv.z * pr, ox0 = scene.width / 2 - cv.x * zs, oy0 = scene.height / 2 - cv.y * zs; sc.setTransform(1, 0, 0, 1, 0, 0); sc.clearRect(0, 0, scene.width, scene.height); moodSky(); sc.imageSmoothingEnabled = true; sc.drawImage(S.canvas, ox0, oy0, S.W * zs, S.H * zs); sc.globalCompositeOperation = "lighter"; sc.globalAlpha = .5; sc.drawImage(S.glow, ox0, oy0, S.glow.width * 4 * zs, S.glow.height * 4 * zs); sc.globalCompositeOperation = "source-over"; sc.globalAlpha = 1; moodPost(ox0, oy0, zs, pr); placeTags(cv.z, ox0 / pr, oy0 / pr, W, H); return; }
    var zc = cv.z * pr, cz = zc >= 2 ? Math.round(zc) : zc, Z = cz, dx = Math.round(scene.width / 2 - cv.x * Z), dy = Math.round(scene.height / 2 - cv.y * Z);
    sc.setTransform(1, 0, 0, 1, 0, 0); sc.clearRect(0, 0, scene.width, scene.height); moodSky();
    var vx = Math.max(0, Math.floor(-dx / cz)), vy = Math.max(0, Math.floor(-dy / cz)), vr = Math.min(S.W, Math.ceil((scene.width - dx) / cz) + 1), vb = Math.min(S.H, Math.ceil((scene.height - dy) / cz) + 1), vw = vr - vx, vh = vb - vy;
    if (vw > 0 && vh > 0) {
      if (low.width !== vw || low.height !== vh || !img) { low.width = vw; low.height = vh; img = lc.createImageData(vw, vh); buf = new Uint32Array(img.data.buffer); dep = new Float32Array(vw * vh); }
      var sb = S.buf, sd = S.dep, SW = S.W;
      for (var r = 0; r < vh; r++) { var off = r * vw, src = (vy + r) * SW + vx; buf.set(sb.subarray(src, src + vw), off); dep.set(sd.subarray(src, src + vw), off); }
      OX = S.ox; OY = S.oy; B = buf; D = dep; E = null; BW = vw; BH = vh; VX = vx; VY = vy; EMIT = 0;
      frameDraw(frame);
      lc.putImageData(img, 0, 0);
      sc.imageSmoothingEnabled = cz < 2;
      sc.drawImage(low, dx + vx * cz, dy + vy * cz, vw * cz, vh * cz);
    }
    sc.globalCompositeOperation = "lighter"; sc.globalAlpha = (.46 + Math.sin(frame * .13) * .04) / (1 + (cz / pr) * .5); sc.imageSmoothingEnabled = true;
    sc.drawImage(S.glow, dx, dy, S.glow.width * 4 * cz, S.glow.height * 4 * cz);
    sc.globalCompositeOperation = "source-over"; sc.globalAlpha = 1;
    /* smog: the air is an item on the bill */
    moodPost(dx, dy, Z, pr);
    placeTags(cz / pr, dx / pr, dy / pr, W, H);
  }
  function setTags() {
    $("#tags").innerHTML = ""; tagEls = [];
    if (!S) return;
    S.pois.forEach(function (q) {
      var b = document.createElement("button"); b.type = "button"; b.className = "tag " + (q.tier === 2 ? "t2" : "t1"); b.textContent = q.n; b.hidden = true;
      b.onclick = function () { barTitle(q.n, q.d); say(q.n + ". " + q.d); var p0 = cityPt(q.x, q.y, q.z); focusOn(p0[0], p0[1], Math.max(cv.z, 2)); };
      $("#tags").appendChild(b); tagEls.push({ el: b, p: cityPt(q.x, q.y, q.z), tier: q.tier });
    });
    if (S.atl) RINGS.forEach(function (r, i) {
      var rr = [10, 22.5, 39, 54.6, 67][i], p = cityPt(Math.cos(2.05) * rr, Math.sin(2.05) * rr, [60, 90, 40, 30, 20][i]);
      var b = document.createElement("button"); b.type = "button"; b.className = "tag ring"; b.textContent = r.n; b.hidden = true;
      b.onclick = function () { selectRing(i, true); }; $("#tags").appendChild(b); tagEls.push({ el: b, p: p, tier: 3 });
    });
  }
  function cityPt(x, y, z) { OX = S.ox; OY = S.oy; return iso(x, y, z); }
  function placeTags(z, ox, oy, W, H) {
    tagEls.forEach(function (e) {
      var sx = e.p[0] * z + ox, sy = e.p[1] * z + oy, show = e.tier === 3 ? z >= .25 : e.tier === 2 ? z >= .42 : z >= 1.1;
      show = show && sx > 0 && sy > 0 && sx < W && sy < H; e.el.hidden = !show;
      if (show) { e.el.style.left = sx + "px"; e.el.style.top = sy + "px"; }
    });
  }
  function placeWorldTags(z, ox, oy, W, H, ms) {
    worldTags.forEach(function (e) {
      var o = NATIONS[e.i], sx = o.mx * z + ox + (o.nx || 0), sy = o.my * z + oy + (o.ny || 0) - (e.i ? 0 : 30), b = e.el;
      b.style.left = sx + "px"; b.style.top = sy + "px"; b.hidden = sx < 0 || sy < 0 || sx > W || sy > H;
    });
  }
  function initWorldTags() {
    $("#wtags").innerHTML = "";
    worldTags = NATIONS.map(function (o, i) {
      var b = document.createElement("button"); b.type = "button"; b.className = "wtag" + (i ? "" : " cap") + (o.free ? " free" : ""); b.setAttribute("aria-label", "Open " + o.n); b.innerHTML = "<span>" + o.n + "</span>";
      b.onmouseenter = function () { hoverN = i; barTitle(o.n, o.status + " · " + o.exp); say(o.her && o.her[0] ? o.her[0] : ""); };
      b.onmouseleave = function () { hoverN = -1; };
      b.onclick = function () { enterCity(i); };
      $("#wtags").appendChild(b); return { el: b, i: i };
    });
  }
  function setStats(cells) { $("#ringstats").innerHTML = cells.map(function (s) { return "<div><small>" + s[0] + "</small><b>" + s[1] + "</b></div>"; }).join(""); }
  function barTitle(n, sub) { $("#bname").textContent = n; $("#bsub").textContent = sub || ""; }
  function worldStats() { barTitle("Concord World", "143 of 197 jurisdictions under contract"); setStats([["Technology lead", "9,000 yrs"], ["Reserves", "11.4 yrs"]]); }
  function natStats(o) { barTitle(o.n, o.status); setStats([["Population", o.pop], ["Wealth index", o.wealth], ["Run by", o.corp]]); }
  function selectRing(i, fly) {
    selRing = i; var r = RINGS[i]; barTitle(r.n + ": " + r.name, r.d); setStats([["Population", r.pop], ["Equity", r.equity], ["Air", r.air], ["Life", r.life]]); syncGoto();
    if (fly) { var q = r.fly, p = cityPt(q[0], q[1], q[2]); focusOn(p[0], p[1], q[3]); } else draw();
  }
  function say(s) { hold = Date.now() + 7000; $("#log").textContent = s; }
  var hold = 0;
  function runJobs(jobs, done) {
    var i = 0, bar = $("#lbar");
    (function nx() { if (i >= jobs.length) { done(); return; } try { jobs[i](); } catch (e) { console.error(e); } i++; bar.style.width = (i / jobs.length * 100) + "%"; setTimeout(nx, 8); })();
  }
  function enterCity(i) {
    if (loading) return;
    var o = NATIONS[i]; selNat = i; selRing = null; renderDossier(o); syncGoto(); natStats(o);
    var go = function () {
      S = scenes[o.id]; mode = "city"; $("#loader").hidden = true; loading = false; img = null;
      $("#btnworld").hidden = false; $("#wtags").hidden = true; $("#frame").hidden = true; $(".cname").textContent = o.n;
      setTags(); var fv = fitCity(), cq = S.atl ? iso(0, 0, 150) : (OX = S.ox, OY = S.oy, iso(S.cbd[0], S.cbd[1], 170 * ZSC[TIER[o.id]])); fitting = false; cv = { x: S.ox, y: S.oy - 140, z: fv.z }; focusOn(cq[0], cq[1], Math.max(fv.z * 2.4, .9));
      say((S.noalloy ? "No Concord grid here. " : "Grid live. ") + S.lives.length + " lives on loop in this sector. Zoom in and click anything that moves."); 
    };
    if (scenes[o.id]) { go(); return; }
    loading = true; $("#ltxt").textContent = "Retrieving " + o.n + " sector data"; $("#lbar").style.width = "0"; $("#loader").hidden = false;
    setTimeout(function () {
      var jobs = o.id === "poseidonis" ? bakeAtlantis() : bakeCity(o.id);
      runJobs(jobs, function () {
        scenes[o.id] = S; sceneOrder.push(o.id);
        while (sceneOrder.length > 2) { var old = sceneOrder.shift(); delete scenes[old]; }
        go();
      });
    }, 30);
  }
  function exitCity() { mode = "world"; S = null; selRing = null; $("#btnworld").hidden = true; $("#wtags").hidden = false; $("#tags").innerHTML = ""; tagEls = []; img = null; worldStats(); selNat = 0; syncGoto(); refit(false); }
  window.openNation = function (i) { renderDossier(NATIONS[i]); enterCity(i); show("dossier"); };
  var gotoSel = $("#goto");
  gotoSel.innerHTML = '<optgroup label="World">' + NATIONS.map(function (o, i) { return '<option value="n' + i + '">' + o.n + "</option>"; }).join("") + '</optgroup><optgroup label="Rings of Poseidonis">' + RINGS.map(function (r, i) { return '<option value="r' + i + '">' + r.n + ": " + r.name + "</option>"; }).join("") + "</optgroup>";
  function syncGoto() { gotoSel.value = selRing !== null ? "r" + selRing : "n" + selNat; }
  gotoSel.onchange = function () {
    var v = gotoSel.value, i = +v.slice(1);
    if (v[0] === "n") { enterCity(i); return; }
    if (mode === "city" && S && S.atl) selectRing(i, true);
    else { enterCity(0); var wait = setInterval(function () { if (mode === "city" && S && S.atl) { clearInterval(wait); setTimeout(function () { selectRing(i, true); }, 650); } }, 120); }
  };
  $("#opendos").onclick = function () { renderDossier(NATIONS[selNat]); show("dossier", true); };
  $("#btnworld").onclick = exitCity;
  $("#fitmap").onclick = function () { selRing = null; refit(true); };
  var pauseBtn = $("#pause");
  var setPause = function () { pauseBtn.textContent = paused ? "▶" : "❚❚"; pauseBtn.setAttribute("aria-label", paused ? "Play" : "Pause"); };
  setPause(); pauseBtn.onclick = function () { paused = !paused; setPause(); };
  function zoomAt(k, x0, y0) {
    fitting = false; tween = null;
    var v = curView(), W = stage.clientWidth, H = stage.clientHeight, lo = mode === "world" ? fitWorld().z * .9 : fitCity().z * .7, hi = mode === "world" ? 7 : 10, z2 = Math.max(lo, Math.min(hi, v.z * k));
    var wx = v.x + (x0 - W / 2) / v.z, wy = v.y + (y0 - H / 2) / v.z;
    setCur({ x: wx - (x0 - W / 2) / z2, y: wy - (y0 - H / 2) / z2, z: z2 }); draw();
  }
  $("#zin").onclick = function () { zoomAt(1.6, stage.clientWidth / 2, stage.clientHeight / 2); };
  $("#zout").onclick = function () { zoomAt(1 / 1.6, stage.clientWidth / 2, stage.clientHeight / 2); };
  scene.addEventListener("wheel", function (e) { e.preventDefault(); var r = scene.getBoundingClientRect(); zoomAt(Math.pow(1.0018, -e.deltaY), e.clientX - r.left, e.clientY - r.top); }, { passive: false });
  var ptrs = {}, dragged = 0, pinch = 0;
  scene.addEventListener("pointerdown", function (e) { scene.setPointerCapture(e.pointerId); ptrs[e.pointerId] = [e.clientX, e.clientY]; dragged = 0; pinch = 0; scene.classList.add("drag"); tween = null; });
  scene.addEventListener("pointermove", function (e) {
    var ids = Object.keys(ptrs);
    if (ids.indexOf(String(e.pointerId)) > -1) {
      var p0 = ptrs[e.pointerId], dx = e.clientX - p0[0], dy = e.clientY - p0[1]; ptrs[e.pointerId] = [e.clientX, e.clientY];
      if (ids.length === 2) { var a = ptrs[ids[0]], b = ptrs[ids[1]], dist = Math.hypot(a[0] - b[0], a[1] - b[1]); if (pinch) { var rc = scene.getBoundingClientRect(); zoomAt(dist / pinch, (a[0] + b[0]) / 2 - rc.left, (a[1] + b[1]) / 2 - rc.top); } pinch = dist; dragged = 99; return; }
      dragged += Math.abs(dx) + Math.abs(dy);
      if (dragged > 3) { fitting = false; var v = curView(); setCur({ x: v.x - dx / v.z, y: v.y - dy / v.z, z: v.z }); draw(); }
      return;
    }
    if (mode === "city" && S && S.atl) { var i = ringUnder(e); if (i !== hoverRing) { hoverRing = i; if (i !== null) { $("#log").textContent = RINGS[i].n + ", " + RINGS[i].name + ". " + RINGS[i].d; hold = Date.now() + 2500; } } }
  });
  var hoverRing = null;
  function lifeUnder(e) {
    if (!S || !S.lives) return null;
    var rc = scene.getBoundingClientRect(), z = cv.z, wx = cv.x + (e.clientX - rc.left - rc.width / 2) / z, wy = cv.y + (e.clientY - rc.top - rc.height / 2) / z, best = null, bd = 16 / z + 6;
    OX = S.ox; OY = S.oy;
    S.lives.forEach(function (L) { var p = iso(L.x, L.y, L.z), dd = Math.hypot(p[0] - wx, p[1] - 6 - wy); if (dd < bd) { bd = dd; best = L; } });
    return best;
  }
  var endPtr = function (e) {
    if (ptrs[e.pointerId] && dragged <= 3 && mode === "city" && S) {
      var L = lifeUnder(e);
      if (L) say(LIFE[L.k]);
      else if (S.atl) { var i = ringUnder(e); if (i !== null) selectRing(i, false); }
    }
    delete ptrs[e.pointerId]; scene.classList.remove("drag");
  };
  scene.addEventListener("pointerup", endPtr); scene.addEventListener("pointercancel", endPtr);
  scene.addEventListener("keydown", function (e) {
    var v = curView(), s = 40 / v.z, k = e.key, n = { x: v.x, y: v.y, z: v.z };
    if (k === "ArrowLeft") n.x -= s; else if (k === "ArrowRight") n.x += s; else if (k === "ArrowUp") n.y -= s; else if (k === "ArrowDown") n.y += s;
    else if (k === "+" || k === "=") { zoomAt(1.6, stage.clientWidth / 2, stage.clientHeight / 2); return; } else if (k === "-") { zoomAt(1 / 1.6, stage.clientWidth / 2, stage.clientHeight / 2); return; } else if (k === "Escape" && mode === "city") { exitCity(); return; } else return;
    e.preventDefault(); fitting = false; setCur(n); draw();
  });
  function ringUnder(e) {
    var rc = scene.getBoundingClientRect(), z = cv.z, wx = cv.x + (e.clientX - rc.left - rc.width / 2) / z, wy = cv.y + (e.clientY - rc.top - rc.height / 2) / z, a = (wx - S.ox) / HW, b = (wy - S.oy) / HH, x = (a + b) / 2, y = (b - a) / 2, i = ringAt(Math.hypot(x, y));
    return i < 0 ? null : i;
  }
  function loop(ts) {
    requestAnimationFrame(loop);
    if (tween) {
      var q = Math.min(1, (ts - tween.t0) / 620), e = q < .5 ? 2 * q * q : 1 - Math.pow(-2 * q + 2, 2) / 2, a = tween.a, b = tween.b;
      setCur({ x: a.x + (b.x - a.x) * e, y: a.y + (b.y - a.y) * e, z: a.z * Math.pow(b.z / a.z, e) });
      if (q >= 1) tween = null;
      draw(); return;
    }
    if (paused || ts - last < 1000 / FPS) return;
    last = ts; frame = (frame + 1) % TOTAL; draw();
  }
  window.refitMap = function () { if (fitting) refit(true); else placeFrame(); };
  var logs = [
    "Ring IV lane 2 extended by 40 m to meet demand.",
    "Shaft 7 subsidence 1.4 mm. Within commercial tolerance.",
    "London grid curtailment commenced on schedule.",
    "Quarterly bull offered to shareholders. Yield unchanged.",
    "Atlantic storm 26-B delivered to contract, Gulf of Guinea.",
    "Freshwater ration adjusted. Notices issued to 2,118 units.",
    "African Compact traffic excluded from this feed.",
    "Advisory sentiment survey closed. Sentiment recorded."
  ];
  var li = 0;
  function nextLog() { if (Date.now() > hold) { $("#log").textContent = stamp(0, true) + "  " + logs[li]; li = (li + 1) % logs.length; } }
  buildMinis(); renderRegister(); renderDossier(NATIONS[0]); worldStats(); syncGoto(); initWorldTags(); placeFrame();
  nextLog(); setInterval(nextLog, 3800);
  refit(false);
  if (window.ResizeObserver) new ResizeObserver(function () { if (fitting) refit(false); else { placeFrame(); draw(); } }).observe(stage);
  requestAnimationFrame(loop);
})();
</script>

</body></html>
