  function tone2(u, f) { var r = Math.min(255, (u & 255) * f), g = Math.min(255, ((u >> 8) & 255) * f), b = Math.min(255, ((u >> 16) & 255) * f); return (0xff000000 | (b << 16) | (g << 8) | r) >>> 0; }
