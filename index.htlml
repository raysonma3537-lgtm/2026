      b(x - 1.4, y - 1.4, x + 1.4, y - .9); b(x - 1.4, y + .9, x + 1.4, y + 1.4); b(x - 1.4, y - .9, x - .9, y + .9); b(x + .9, y - .9, x + 1.4, y + .9);
