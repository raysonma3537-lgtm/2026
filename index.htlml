  /* ---------- a skyline of its own: one skyscraper tradition per city ---------- */
  ALLOYPAL.cobalt = [c("#7a9cff"), c("#3050c8"), c("#16225e")];
  ALLOYPAL.shell = [c("#fff6e8"), c("#d8d0c8"), c("#8a8aa8")];
  function neonBand(x, y, w, z, col) { gbox(x - w - .04, y - w - .04, x + w + .04, y + w + .04, z, z + 1, col, col, col); }
  var SKY = {
    london: function (x, y, h, k) { /* soot Gothic: brick shafts, stone pinnacles, a clock in every tower */
      var w = 1.5 + hash(k, 1) * .4, brick = hash(k, 2) > .5 ? c("#6a4a40") : c("#54463f");
      box(x - w, y - w, x + w, y + w, 0, h * .62, dk(P.ash2), wall(brick, .34, c("#ffb060"), 2.4, 7), wall(tone2(brick, 1.25), .34, P.glow, 2.4, 7));
      box(x - w * .72, y - w * .72, x + w * .72, y + w * .72, h * .62, h * .84, dk(P.ash2), wall(P.dullB, .3, c("#ffb060"), 2.4, 7), wall(P.ash, .3, P.glow, 2.4, 7));
