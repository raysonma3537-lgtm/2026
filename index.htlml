    { id: "delhi", lon: 77.2, lat: 28.6, s: "E", k: "delhi", n: "Delhi", full: "Delhi, Indo-Gangetic Labour Reserve", status: "Labour Reserve", tag: "Labour", pop: "46 M", debt: "ORC 2.6 T", exp: "Skilled labour", pres: "Pillar Workforce",
      then: "Capital of empires for a thousand years and a centre of Indian Ocean trade.", during: "Monsoon failures in the 2000s pushed water and grain into Concord futures. Migration visas became the state's largest export.", now: "Forty million workers hold Continental Sponsorship abroad. Most of Ring IV in Poseidonis sends money home to the Ganges plain.", note: "Remittances are taxed at both ends." },
    { id: "beijing", lon: 116.4, lat: 39.9, s: "E", k: "beijing", n: "Beijing", full: "Beijing, Fourth Harbour Accord Signatory", status: "Treaty Power", tag: "Treaty power", pop: "54 M", debt: "ORC 6.8 T", exp: "Manufacturing", pres: "Concord Trade Office",
