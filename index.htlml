  var POWER = {
    poseidonis: ["100", "The Board of Ten", "Hours of the Ring", ["Founders' Ring", "Harbour Ring", "The Margins"], "Nobody in the city's top three rings has been hungry in four hundred years."],
    gades: ["61", "House of Gadeirus", "The Toll Brothers", ["Pillar Quay", "Old Tyrian Mile", "The Saltings"], "Runs the only harbour on Earth with no recorded collision in a century."],
    athens: ["44", "Meridian Trust", "The Ostracised", ["Piraeus Exchange", "Kerameikos", "The Long Walls"], "Its unlicensed Assembly still votes every tenth day, and still keeps minutes."],
    alexandria: ["52", "Pharos Holdings", "The Unshelved", ["Pharos Quarter", "Rhakotis", "Lake Mareotis Flats"], "Its street scribes copy banned books by hand, and have never lost one."],
    carthage: ["49", "Barca Maritime", "The Byrsa Boys", ["Cothon", "Megara", "The Salt Lots"], "Built the fastest merchant hull in history, without an Atlantean licence."],
    newyork: ["54", "Exchange Branch 2", "Tidewater Local", ["Bay Exchange", "Tidewater", "The Marsh Lots"], "Its dockers won the only strike the Concord has ever lost."],
    tenochtitlan: ["47", "Mexica Joint Venture", "The Eagle Lodges", ["Templo Exchange", "Tlatelolco", "The Dry Lake"], "Chinampa farms still feed nine million people, without a single Atlas contract."],
    mutal: ["39", "K'uhul Holdings", "Sons of the Ceiba", ["Great Plaza Exchange", "Causeway Row", "The Burn"], "Its mathematicians have never had an error found in a long-count settlement."],
    beijing: ["36", "Concord Trade Office", "Blue Lanterns", ["Export Quarter", "The Hutong Stacks", "Sixth Ring Lots"], "Builds most of what the Concord consumes, and has started to design it too."],
    delhi: ["27", "Pillar Workforce", "The Remitters", ["Sponsorship Quarter", "Old City", "Yamuna Flats"], "Indian Atlantic has the finest modern literature in the language."],
    lagos: ["31", "Atlas Maritime", "Area Boys", ["Marina", "Mainland", "Makoko Reach"], "Its floating schools have the highest pass rate on the continent."],
    tokyo: ["33", "Concord Stability Office", "The Quiet Ones", ["Marunouchi", "Shitamachi", "Reclaimed Lots"], "Has not missed a train in sixty years, including during the quakes."],
    saopaulo: ["26", "Atlas Offset", "Sons of the Tupi", ["Centro", "The Hills", "Fence Line"], "Replanted forty thousand hectares on its own, then was billed for it."],
    joburg: ["29", "Deep-Core Southern", "The Rand Lords", ["Sandton Rings", "The Reef", "Township Lots"], "Its miners' union runs the best hospital in the south."],
    kinshasa: ["14", "Orichal Minerals", "Les Sapeurs", ["Gombe", "La Cité", "Pit Edge"], "Its musicians are heard in every city on this map, unpaid."],
    addis: ["22", "None recognised", "None recorded", ["Merkato Exchange", "Old Addis", "The Terraces"], "Runs twenty-two states on a solar grid no company owns."],
    london: ["18", "Orichal Energy", "The Thames Mudlarks", ["The City", "Southwark", "Estuary Lots"], "Its night-school movement has taught three million people for free."],
    lisbon: ["16", "Trident Lines", "The Fado Men", ["Baixa", "Alfama", "Tagus Flats"], "Still sings in Portuguese, which is otherwise a village dialect of Gades."],
    moscow: ["19", "Orichal Polar", "The Thieves-in-Law", ["Garden Ring", "Panel Districts", "Thaw Lots"], "Its chess schools have produced every world champion since 1920."],
