      pyramid(x, y, 1.5, h, 2.2, P.pearl, P.glass, P.white); for (var i = 0; i < 8; i++) { var w = .3 + i * .17; box(x - w, y - w, x + w, y + w, h - 12 + i * 1.5, h - 10 + i * 1.5, P.pearl, P.glass, P.white); }
      S.nodes.push([x, y, h + 12]);
    },
    dubai: function (x, y, h, k) { pour(x, y, 2.4, h, { prof: ["needle", "spindle", "hourglass"][k % 3], ry: .55, pal: k % 2 ? ALLOYPAL.glass : ALLOYPAL.pearl, ribs: 4 + k % 4, seg: 36, litp: .7, lit: k % 2 ? P.cyan : P.glow }); },
    delhi: function (x, y, h, k) { /* a Qutb tower: fluted red sandstone, marble balconies, a dome on top */
      var r0 = 2, z = 0, n = 5;
      for (var t = 0; t < n; t++) { var hh = h / n, r1 = r0 * .86; shaft(x, y, r0, r1, z, hh, c("#c8604a"), c("#94402f"), c("#5a2418"), 5); for (var a = 0; a < 6.283; a += .35) { pt(x + Math.cos(a) * r1 * .95, y + Math.sin(a) * r1 * .95, z + hh * .5, (a * 3 | 0) & 1 ? P.amber : P.glow, 1); } disc(x, y, r1 + .35, z + hh, dk(P.white)); disc(x, y, r1 + .35, z + hh + 1, dk(P.white2)); z += hh + 2; r0 = r1; }
      dome(x, y, r0, z, P.white, P.white2, P.pearl3); for (var i = 0; i < 12; i++) pt(x, y, z + r0 * 5 + i, P.amber, 1); light(x, y, z, P.glow, 42, .6);
    },
    beijing: function (x, y, h, k) { /* a pagoda at the scale of a tower block */
      var n = Math.max(5, Math.round(h / 20)), z = 0, w = 2.3;
      for (var t = 0; t < n; t++) {
        var hh = h / n; box(x - w * .72, y - w * .72, x + w * .72, y + w * .72, z, z + hh - 4, dk(P.redst), wall(c("#8a2f2c"), .8, P.amber, 3, 4), wall(c("#b03a30"), .8, P.glow, 3, 4));
