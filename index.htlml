      vsign(x + 1.1, y - .4, 8, 2, P.red, -1);
      S.steam.push([x, y, 4, .2]); light(x, y + .9, 4, P.glow, 30, .8);
    },
    shrine: function (x, y) {
      disc(x, y, 1.8, .2, dk(P.mud3));
      box(x - 1, y - 1, x + 1, y - .3, 0, 2, P.white2, P.white2, P.white);
      for (var i = 0; i < 3; i++) box(x - .9 + i * .85, y - .9, x - .75 + i * .85, y - .75, 2, i === 1 ? 9 : 12, P.white, P.white2, P.white);
      box(x - 1, y - 1, x + .4, y - .6, 12, 14, P.white2, P.white2, P.white2);
      trident(x + .2, y - .4, 2, 9, P.oreD);
      for (i = 0; i < 12; i++) { var a = hash(i, 4) * 3.1, rr = .4 + hash(i, 5) * .9; S.flick.push([x + Math.cos(a) * rr, y + Math.sin(a) * rr * .8, 1, 1]); }
      for (i = 0; i < 5; i++) act(x - 1 + i * .5, y + 1.1, i % 2 ? "ma" : "ma2", "kneel", i);
      light(x, y, 3, P.fire, 34, .9);
    },
    bazaarScrap: function (x, y) {
      for (var i = 0; i < 28; i++) { var a = hash(i, 8) * 6.28, r = hash(i, 9) * 3.4; box(x + Math.cos(a) * r - .2, y + Math.sin(a) * r - .2, x + Math.cos(a) * r + .2, y + Math.sin(a) * r + .2, 0, 1 + hash(i, 3) * 5, [P.tinr, P.rust, P.tarp, P.steel][i % 4], P.rust2, P.tinr2); }
      crowdIn(x, y, 3, 12, ["ma", "ma2", "kid"]);
      box(x - .5, y - .5, x + .5, y + .5, 0, 18, P.rust, P.rust2); S.cranes.push([x, y, 18]);
    },
    theatre: function (x, y) {
      for (var i = 0; i < 6; i++) { var rr = 2 + i * .55; circ(x, y, rr, i + 1, function (t0, h) { return (t0 > .3 && t0 < 3.4) ? dk(h === i + 1 ? P.white : P.white2) : 0; }); }
      for (i = 0; i < 40; i++) { var a = .4 + hash(i, 2) * 2.9, r = 2.2 + (i % 6) * .55; act(x + Math.cos(a) * r, y + Math.sin(a) * r, ["cit", "ex", "ci2"][i % 3], "seat", (i % 6) + 2); }
      S.holos.push({ x: x, y: y - .4, z: 4, g: "face", s: 1, col: P.pink, tiny: true });
      light(x, y, 4, P.pink, 50, .9);
    },
    dream: function (x, y, n) {
      plaza(x, y, 3.4, P.black, P.steelD);
      for (var i = 0; i < n; i++) { var u = x - 2.6 + (i % 6) * 1.04, v = y - 2 + Math.floor(i / 6) * 1.4; box(u, v, u + .7, v + .4, 0, 2, P.steelD, P.steel); gbox(u + .08, v + .05, u + .62, v + .35, 2, 2.2, P.violet); S.flick.push([u + .35, v + .2, 3, 2]); }
      light(x, y, 4, P.violet, 56, .8);
    },
    years: function (x, y) {
      box(x - 1.6, y - 1.2, x + 1.6, y + .6, 0, 12, dk(P.black), P.blackst, P.black);
      for (var i = 0; i < 10; i++) act(x - 2.8 + i * .5, y + 1.3, ["lab", "cit", "co2"][i % 3], "queue", i);
      gbox(x - 1.5, y + .6, x + 1.5, y + .66, 8, 11, P.cyan); light(x, y + 1, 8, P.cyan, 46, .9);
    },
    ancestors: function (x, y) {
      disc(x, y, 3.6, .2, dk(P.green3));
      for (var i = 0; i < 26; i++) { var a = hash(i, 5) * 6.28, r = hash(i, 6) * 3.2; box(x + Math.cos(a) * r - .12, y + Math.sin(a) * r - .08, x + Math.cos(a) * r + .12, y + Math.sin(a) * r + .08, 0, 3, P.white, P.white2); }
      for (i = 0; i < 8; i++) act(x + (hash(i, 7) - .5) * 5, y + (hash(i, 8) - .5) * 5, "ghost", "wander", .5, hash(i, 9));
      for (i = 0; i < 5; i++) act(x + (hash(i, 17) - .5) * 5, y + (hash(i, 18) - .5) * 5, "ci2", "wander", .3, hash(i, 19));
      light(x, y, 4, P.cyan, 48, .5);
    },
    spa: function (x, y) {
      disc(x - 1.2, y, 1.1, .3, lit(P.w1b)); disc(x + 1.2, y, 1.1, .3, lit(P.red));
      S.steam.push([x + 1.2, y, 2, .1]); S.steam.push([x + 1, y + .4, 2, .4]); S.steam.push([x + 1.4, y - .4, 2, .7]);
      for (var i = 0; i < 8; i++) act(x + (i < 4 ? -1.2 : 1.2) + Math.cos(i * 1.6) * .6, y + Math.sin(i * 1.6) * .6, "el", "still");
      light(x - 1.2, y, 3, P.cyan, 30, .6); light(x + 1.2, y, 3, P.red, 30, .6);
    },
    bull: function (x, y) {
