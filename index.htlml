<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Atlantean Concord</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans+Condensed:wght@500;600&family=IBM+Plex+Sans:wght@400;500;600&family=Marcellus&display=swap">
<style>
/* Layout: an operations console. Sidebar left, the live isometric sector floating directly on the ocean in the centre, the selected data stream right. */
:root {
  --navy: #0a1446;
  --purple: #2c0d58;
  --amber: #f5b93f;
  --minion: #f5e050;
  --black: #080808;
  --line: rgba(245, 185, 63, .34);
  --dim: rgba(245, 185, 63, .74);
  --wash: rgba(245, 185, 63, .1);
  --display: "Marcellus", "Times New Roman", serif;
  --body: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif;
  --label: "IBM Plex Sans Condensed", "Arial Narrow", system-ui, sans-serif;
  --data: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
  color-scheme: dark;
}
* { box-sizing: border-box; border-radius: 0; }
html, body { height: 100%; }
body {
  background: var(--navy);
  color: var(--amber);
  font: 400 15px/1.5 var(--body);
  overflow-x: hidden;
}
.ocean, .grid { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
.ocean {
  background:
    radial-gradient(90% 75% at 78% 18%, rgba(70, 24, 130, .75), transparent 70%),
    radial-gradient(80% 80% at 12% 88%, rgba(44, 13, 88, .9), transparent 72%),
    linear-gradient(135deg, var(--navy) 0%, #161050 42%, var(--purple) 100%);
}
.grid {
  background: repeating-linear-gradient(to bottom, transparent 0 47px, var(--minion) 47px 48px);
  opacity: .22;
}
.box { background: var(--black); border: 1px solid var(--amber); min-width: 0; pointer-events: auto; }

/* Compact console: thin top bar, narrow rail, slim bottom bar, map everywhere else */
html, body { overflow: hidden; }
.stage { position: fixed; inset: 0; z-index: 1; overflow: hidden; }
#scene { display: block; width: 100%; height: 100%; cursor: grab; touch-action: none; }
#scene.drag { cursor: grabbing; }
#tags, #wtags { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
.frame { position: fixed; z-index: 2; pointer-events: none; border: 3px double var(--amber); }
.frame::before { content: ""; position: absolute; inset: 3px; border: 1px solid var(--line); }
.frame::after { content: ""; position: absolute; inset: -5px; background: linear-gradient(var(--amber), var(--amber)) 0 0 / 9px 9px no-repeat, linear-gradient(var(--amber), var(--amber)) 100% 0 / 9px 9px no-repeat, linear-gradient(var(--amber), var(--amber)) 0 100% / 9px 9px no-repeat, linear-gradient(var(--amber), var(--amber)) 100% 100% / 9px 9px no-repeat; }
.frame .ct { position: absolute; left: 12px; top: 8px; font: 400 15px/1.2 var(--display); letter-spacing: .1em; color: var(--amber); background: var(--black); padding: 3px 9px; border: 1px solid var(--line); }
.frame .ct small { display: block; font: 400 9.5px/1.3 var(--data); letter-spacing: .04em; color: var(--dim); }
.frame .sc { position: absolute; right: 12px; bottom: 8px; font: 400 10px/1.3 var(--data); color: var(--dim); background: var(--black); padding: 3px 7px; border: 1px solid var(--line); text-align: right; }
.wtag {
  position: absolute; transform: translate(-50%, -62%); width: 52px; height: 48px; pointer-events: auto; cursor: pointer;
  appearance: none; background: transparent; border: 0; padding: 0; color: var(--amber);
}
.wtag span {
  position: absolute; left: 50%; bottom: -11px; transform: translateX(-50%); white-space: nowrap; pointer-events: none;
  font: 600 9.5px/1.15 var(--label); letter-spacing: .05em; text-transform: uppercase; color: var(--amber); padding: 0 3px; background: rgba(8, 8, 8, .66);
}
.wtag.cap span { color: var(--black); background: var(--amber); }
.wtag.free span { color: #6fe09a; }
.wtag:hover span, .wtag:focus-visible span { background: var(--amber); color: var(--black); }
.tag {
  position: absolute; transform: translate(-50%, -100%); pointer-events: auto; cursor: pointer; white-space: nowrap;
  appearance: none; background: rgba(8, 8, 8, .82); color: var(--amber); border: 1px solid var(--line); padding: 1px 5px;
  font: 500 10.5px/1.3 var(--label); letter-spacing: .04em;
}
.tag.t2 { border-color: var(--minion); color: var(--minion); }
.tag.ring { border-color: var(--amber); font-weight: 600; text-transform: uppercase; background: var(--black); }
.tag:hover { background: var(--amber); color: var(--black); }

.top { position: fixed; z-index: 3; left: 0; right: 0; top: 0; display: flex; align-items: stretch; height: 30px; background: var(--black); border-bottom: 1px solid var(--amber); padding-left: env(safe-area-inset-left, 0px); padding-right: env(safe-area-inset-right, 0px); }
.top .wm { flex: none; display: flex; align-items: center; padding: 0 12px; font: 400 15px/1 var(--display); letter-spacing: .13em; text-transform: uppercase; border-right: 1px solid var(--line); }
.tape { overflow: hidden; flex: 1; min-width: 0; display: flex; align-items: center; }
.tape-run { display: inline-flex; white-space: nowrap; animation: run 74s linear infinite; }
.tape:hover .tape-run { animation-play-state: paused; }
.tape-run span.item { padding-right: 26px; font: 400 12px/1.3 var(--data); }
.tape-run span.item::before { content: "\25B6"; font-size: 7px; padding: 0 8px 0 14px; color: var(--minion); vertical-align: 1px; }
@keyframes run { to { transform: translateX(-50%); } }
.top .ro { flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-left: 1px solid var(--line); font: 500 11.5px/1 var(--data); font-variant-numeric: tabular-nums; }
.top .ro small { font: 500 10px/1 var(--label); letter-spacing: .08em; text-transform: uppercase; color: var(--dim); }
.seg2 { flex: none; display: flex; border-left: 1px solid var(--line); }
.seg2 button { appearance: none; background: transparent; border: 0; color: var(--amber); padding: 0 8px; font: 600 10.5px/1 var(--label); letter-spacing: .04em; cursor: pointer; }
.seg2 button[aria-pressed="true"] { background: var(--amber); color: var(--black); }

.rail { position: fixed; z-index: 3; left: max(6px, env(safe-area-inset-left, 0px)); top: 38px; width: 44px; display: grid; background: var(--black); border: 1px solid var(--amber); }
.rail button {
  appearance: none; position: relative; background: transparent; color: var(--amber); border: 0; border-bottom: 1px solid var(--line); height: 40px; cursor: pointer;
  font: 600 10.5px/1 var(--data); letter-spacing: .02em;
}
.rail button:last-child { border-bottom: 0; }
.rail button:hover { background: var(--wash); }
.rail button[aria-selected="true"] { background: var(--amber); color: var(--black); }
.rail button::after {
  content: attr(data-full); position: absolute; left: calc(100% + 6px); top: 50%; transform: translateY(-50%); white-space: nowrap; display: none;
  background: var(--black); color: var(--amber); border: 1px solid var(--amber); padding: 3px 7px; font: 500 11.5px/1.2 var(--label); letter-spacing: .04em; z-index: 5;
}
.rail button:hover::after, .rail button:focus-visible::after { display: block; }

.dock { position: fixed; z-index: 3; left: max(6px, env(safe-area-inset-left, 0px)); right: max(6px, env(safe-area-inset-right, 0px)); bottom: 6px; background: var(--black); border: 1px solid var(--amber); padding: 4px 8px; display: grid; gap: 3px; }
.dock .r1 { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; }
.dock .tt { min-width: 0; flex: 1 1 200px; }
.dock .tt b { font: 400 14px/1.15 var(--display); letter-spacing: .04em; margin-right: 8px; }
.dock .tt span { font: 400 11.5px/1.3 var(--body); color: var(--dim); }
.ringstats { display: flex; gap: 14px; }
.ringstats small { display: block; font: 500 9.5px/1.1 var(--label); letter-spacing: .08em; text-transform: uppercase; color: var(--dim); }
.ringstats b { display: block; font: 500 12px/1.2 var(--data); font-variant-numeric: tabular-nums; }
.tools { display: flex; align-items: center; gap: 4px; }
.tools select { width: 128px; padding: 3px 4px; font: 500 11.5px/1.2 var(--data); }
.btn { appearance: none; background: transparent; color: var(--amber); border: 1px solid var(--amber); cursor: pointer; font: 600 11px/1.2 var(--label); letter-spacing: .05em; padding: 4px 7px; text-transform: uppercase; }
.btn:hover { background: var(--wash); }
.btn.solid { background: var(--amber); color: var(--black); }
.btn.solid:hover { background: var(--minion); }
.btn.sq { width: 25px; padding: 4px 0; font-size: 12px; }
.dock .log { font: 400 11.5px/1.35 var(--data); color: var(--dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.loader { position: fixed; z-index: 6; left: 50%; top: 50%; transform: translate(-50%, -50%); width: min(320px, 80vw); background: var(--black); border: 1px solid var(--amber); padding: 12px 14px; font: 400 12.5px/1.4 var(--data); }
.loader i { display: block; height: 4px; margin-top: 8px; border: 1px solid var(--line); }
.loader i b { display: block; height: 100%; width: 0; background: var(--amber); transition: width .15s; }
.stream { position: fixed; z-index: 3; right: max(6px, env(safe-area-inset-right, 0px)); top: 36px; bottom: 62px; width: clamp(240px, 34vw, 380px); overflow-y: auto; overflow-x: hidden; scrollbar-color: var(--amber) var(--black); scrollbar-width: thin; }
.closebar { position: sticky; top: 0; z-index: 2; margin-bottom: 6px; display: flex; justify-content: flex-end; }
.closebar .btn { padding: 3px 8px; }
.stream .pad { padding: 10px 12px; }
.stream .phead h1 { font-size: 20px; }
.stream .phead p, .stream .list, .stream details.story p, .stream .evo p { font-size: 13px; }
.stream details.story summary { padding: 10px 12px; }
.stream details.story .more { padding: 0 12px 10px; }
.stream details.story h2 { font-size: 16.5px; }
.stream .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.stream .stats > div { padding: 7px 10px; border-bottom: 1px solid var(--line); }
.stream .stats > div:nth-child(2n) { border-right: 0; }
.stream .stats b { font-size: 16px; }
.stream .stats b.sm { font-size: 12.5px; }
.stream .form { grid-template-columns: minmax(0, 1fr) !important; gap: 6px; }
.stream .row { grid-template-columns: 48px minmax(0, 1fr) 72px; padding: 7px 12px; font-size: 12.5px; gap: 2px 6px; }
.stream .row .dep { display: none; }
.stream .ledger { font-size: 12.5px; }
.stream .brandrow { grid-template-columns: minmax(0, 1fr) 70px; }
.stream .brandrow .spark { display: none; }
.stream .acct { grid-template-columns: minmax(0, 1fr); font-size: 12.5px; }
.stream details.line summary, .stream .sumline { font-size: 12.5px; }
.stream .tl summary { grid-template-columns: minmax(0, 1fr); }
.stream .tl summary p { grid-column: 1; font-size: 13px; }
.stream .tl .x { margin-left: 0; font-size: 13px; }
.stream .rrow { padding: 7px 12px; }
.panel { display: grid; gap: 8px; align-content: start; min-width: 0; }
.rrow { appearance: none; width: 100%; background: transparent; color: var(--amber); border: 0; border-top: 1px solid var(--line); cursor: pointer; text-align: left; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 10px; padding: 8px 14px; font: 400 13px/1.35 var(--data); }
.rrow:first-child { border-top: 0; }
.rrow:hover { background: var(--wash); }
.rrow b { font: 600 14.5px/1.3 var(--body); }
.rrow small { grid-column: 1 / -1; color: var(--dim); font-size: 12px; }
.stats b.sm { font-size: 13.5px; line-height: 1.3; overflow-wrap: anywhere; }
.evo { display: grid; gap: 12px; }
.evo b { font: 600 13px/1.3 var(--label); letter-spacing: .05em; text-transform: uppercase; color: var(--minion); }
.evo p { margin: 3px 0 0; font-size: 14px; }
@media (max-width: 900px) { .top .hide-m, .seg2 { display: none; } .ringstats { display: none; } }
@media (max-width: 720px) {
  .rail { top: 34px; left: 6px; right: 6px; width: auto; grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .rail button { border-bottom: 0; border-right: 1px solid var(--line); height: 28px; }
  .rail button:last-child { border-right: 0; }
  .rail button::after { display: none !important; }
  .stream { top: 66px; bottom: 76px; width: min(70vw, 300px); }
  .wtag { width: 30px; height: 30px; }
  .wtag span { display: none; }
  .wtag.cap span { display: block; }
  .frame .ct, .frame .sc { display: none; }
  .tools select { width: 100px; }
}
@media (prefers-reduced-motion: reduce) { .tape { overflow-x: auto; } .tape-run { animation: none; } }

.homes { position: fixed; z-index: 4; right: max(6px, env(safe-area-inset-right, 0px)); top: 40px; bottom: 92px; width: min(380px, calc(100vw - 12px)); background: rgba(8, 8, 8, .96); border: 1px solid var(--amber); display: flex; flex-direction: column; overflow: hidden; color: var(--amber); }
.homes header { display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-bottom: 1px solid var(--line); }
.homes header b { font: 400 14px/1.2 var(--display); letter-spacing: .06em; }
.homes header span { flex: 1; font: 400 11px/1.2 var(--body); color: var(--dim); }
.hstats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; border-bottom: 1px solid var(--line); }
.hstats div { padding: 4px 8px; } .hstats small { display: block; font: 500 9px/1.2 var(--label); text-transform: uppercase; color: var(--dim); } .hstats b { font: 600 13px/1.3 var(--label); }
.homes .bad { color: #ff5a4a; }
.hfilt { display: flex; flex-wrap: wrap; gap: 4px; padding: 6px 8px; border-bottom: 1px solid var(--line); }
.chip { appearance: none; background: transparent; color: var(--amber); border: 1px solid var(--line); font: 500 10px/1.2 var(--label); padding: 3px 7px; cursor: pointer; text-transform: uppercase; letter-spacing: .05em; }
.chip.on, .chip:hover { background: var(--amber); color: var(--black); }
.hview { border-bottom: 1px solid var(--line); }
.hview canvas { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; image-rendering: pixelated; background: #000; }
.hdet { padding: 6px 10px 8px; font: 400 12px/1.4 var(--body); color: #e8dcc0; }
.hdet h4 { margin: 0 0 2px; font: 600 12.5px/1.3 var(--label); color: var(--amber); letter-spacing: .03em; }
.hdet p { margin: 2px 0; } .hdet ul { margin: 4px 0; padding-left: 16px; } .hdet .fine { color: var(--dim); font-size: 11px; font-style: italic; }
.hlist { list-style: none; margin: 0; padding: 0; overflow-y: auto; flex: 1; }
.hitem { appearance: none; display: block; width: 100%; text-align: left; background: transparent; border: 0; border-bottom: 1px solid var(--line); color: #e8dcc0; padding: 7px 10px; cursor: pointer; font: 400 11.5px/1.35 var(--body); }
.hitem:hover, .hitem.on { background: rgba(245, 185, 63, .12); }
.hitem .ht { display: inline-block; font: 600 9px/1.3 var(--label); text-transform: uppercase; color: var(--black); background: var(--amber); padding: 0 4px; margin-right: 6px; }
.hitem b { font: 600 12px/1.3 var(--label); color: var(--amber); } .hitem small { display: block; color: var(--dim); font-size: 10.5px; }
.hp { display: block; font: 600 11.5px/1.4 var(--label); color: #fff; } .hp em { font-style: normal; font-weight: 500; font-size: 10px; margin-left: 4px; } .hp em.up { color: #ff5a4a; } .hp em.up0 { color: #6fe09a; }
.tag.home { border-color: #6fe09a; color: #6fe09a; } .tag.home.pent, .tag.home.sky { border-color: var(--amber); color: var(--black); background: var(--amber); font-weight: 600; } .tag.home.micro, .tag.home.cap { border-color: #ff7a6a; color: #ffb0a0; }
#homesbtn.on { background: var(--amber); color: var(--black); }
@media (max-width: 640px) { .homes { top: auto; height: 62vh; bottom: 96px; } }

/* Data stream */
.stream { min-height: 0; min-width: 0; overflow-y: auto; overflow-x: hidden; scrollbar-color: var(--amber) var(--black); }
.panel { display: grid; gap: 12px; align-content: start; min-width: 0; }
.panel:focus-visible { outline-offset: -2px; }
.pad { padding: 14px 16px; }
.phead h1 { margin: 2px 0 4px; font: 400 25px/1.15 var(--display); letter-spacing: .03em; text-wrap: balance; }
.phead p { margin: 0; color: var(--dim); font-size: 14px; max-width: 62ch; }
h3.sub { margin: 0 0 10px; font: 600 13.5px/1.25 var(--label); letter-spacing: .09em; text-transform: uppercase; }
.term { transition: background .2s; }
.legacy .term { background: var(--amber); color: var(--black); padding: 0 3px; }
.banner { background: var(--minion); color: var(--black); padding: 8px 14px; font: 600 13px/1.35 var(--label); letter-spacing: .03em; }

.stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
.stats > div { padding: 11px 14px; border-right: 1px solid var(--line); min-width: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 4px; }
.stats small { display: block; }
.stats > div:last-child { border-right: 0; }
.stats b { display: block; font: 500 21px/1.2 var(--data); font-variant-numeric: tabular-nums; }

.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chips button {
  appearance: none; background: var(--black); color: var(--amber); border: 1px solid var(--amber); cursor: pointer;
  font: 600 12.5px/1.2 var(--label); letter-spacing: .06em; padding: 7px 11px;
}
.chips button[aria-pressed="true"] { background: var(--amber); color: var(--black); }

details.story summary { cursor: pointer; list-style: none; padding: 14px 16px; }
details summary::-webkit-details-marker { display: none; }
details.story h2 { margin: 3px 0 6px; font: 400 20px/1.22 var(--display); text-wrap: balance; }
details.story p { margin: 0; font-size: 14.5px; max-width: 66ch; }
details.story .more { padding: 0 16px 14px; display: grid; gap: 8px; }
details.story .hint { display: block; margin-top: 8px; font: 600 12.5px/1 var(--label); letter-spacing: .07em; text-transform: uppercase; color: var(--minion); }
details.story[open] .hint .o { display: none; }
details.story:not([open]) .hint .c { display: none; }
.slug { display: flex; justify-content: space-between; gap: 10px; font: 500 12px/1.3 var(--data); color: var(--dim); }

/* Transit */
.form { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; align-items: end; }
.field { display: grid; gap: 4px; min-width: 0; }
.field label, .field .lbl { font: 500 11.5px/1.2 var(--label); letter-spacing: .1em; text-transform: uppercase; color: var(--dim); }
select {
  width: 100%; background: var(--black); color: var(--amber); border: 1px solid var(--amber); padding: 7px 8px;
  font: 500 13.5px/1.25 var(--data); min-width: 0;
}
.board { display: grid; }
.row {
  appearance: none; width: 100%; background: transparent; color: var(--amber); border: 0; border-top: 1px solid var(--line);
  display: grid; grid-template-columns: 62px minmax(0, 1fr) 54px 92px; gap: 2px 10px; text-align: left; cursor: pointer;
  padding: 9px 16px; font: 400 13.5px/1.35 var(--data); font-variant-numeric: tabular-nums;
}
.row:hover { background: var(--wash); }
.row[aria-pressed="true"] { background: var(--amber); color: var(--black); }
.row b { font-weight: 600; }
.row .r { text-align: right; }
.row .sub2 { grid-column: 2 / -1; font-size: 12px; opacity: .8; }
.flag { display: inline-block; border: 1px solid currentColor; padding: 0 5px; font-size: 11.5px; }
.ledger { width: 100%; border-collapse: collapse; font: 400 13.5px/1.4 var(--data); font-variant-numeric: tabular-nums; }
.ledger th, .ledger td { padding: 6px 0; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
.ledger th { font: 500 11.5px/1.2 var(--label); letter-spacing: .1em; text-transform: uppercase; color: var(--dim); }
.ledger .n { text-align: right; padding-left: 12px; white-space: nowrap; }
.ledger tr.tot td { font-weight: 600; border-bottom: 0; padding-top: 9px; }
.actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 12px; }
.msg { font: 400 13px/1.45 var(--data); margin: 10px 0 0; padding: 8px 10px; border: 1px solid var(--minion); }
.list { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; font-size: 14px; }
.list li { padding-left: 12px; border-left: 1px solid var(--line); }
.list b { font-weight: 600; }

/* Markets */
.brandrow { display: grid; grid-template-columns: minmax(0, 1fr) 96px 78px; gap: 3px 12px; align-items: center; padding: 10px 0; border-top: 1px solid var(--line); }
.brandrow:first-of-type { border-top: 0; }
.brandrow h4 { margin: 0; font: 600 15px/1.25 var(--body); }
.brandrow i { font-size: 13px; color: var(--dim); }
.brandrow .px { text-align: right; font: 500 14px/1.3 var(--data); font-variant-numeric: tabular-nums; }
.brandrow .px small { display: block; font-size: 11.5px; color: var(--dim); }
.brandrow .share { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1fr) 48px; gap: 10px; align-items: center; font: 400 12.5px/1 var(--data); }
.bar { height: 6px; border: 1px solid var(--line); }
.bar > span { display: block; height: 100%; background: var(--amber); }
.spark { width: 96px; height: 28px; display: block; }
.legend { display: flex; flex-wrap: wrap; gap: 4px 18px; font: 400 12.5px/1.4 var(--data); margin-bottom: 6px; }
.legend i { display: inline-block; width: 18px; height: 0; border-top: 2px solid var(--amber); vertical-align: middle; margin-right: 6px; }
.legend i.q { border-top: 2px dashed var(--minion); }
.chartwrap { position: relative; }
.chartwrap svg { display: block; width: 100%; height: auto; }
.tip {
  position: absolute; top: 4px; background: var(--black); border: 1px solid var(--minion); padding: 5px 8px;
  font: 400 12px/1.4 var(--data); pointer-events: none; white-space: nowrap;
}
.acct { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3px 16px; font: 400 13px/1.45 var(--data); margin-bottom: 10px; }
details.line { border-bottom: 1px solid var(--line); }
details.line summary {
  display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; padding: 6px 0; cursor: pointer; list-style: none;
  font: 400 13.5px/1.4 var(--data); font-variant-numeric: tabular-nums;
}
details.line summary:hover { background: var(--wash); }
details.line summary::before { content: none; }
details.line p { margin: 0 0 8px; font-size: 13.5px; color: var(--dim); max-width: 60ch; }
.sumline { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; padding: 5px 0; font: 400 13.5px/1.4 var(--data); font-variant-numeric: tabular-nums; }
.sumline.big { font-weight: 600; font-size: 15px; border-top: 1px solid var(--amber); margin-top: 4px; padding-top: 8px; }
.sumline.owed { background: var(--amber); color: var(--black); padding: 6px 8px; font-weight: 600; margin-top: 4px; }

/* History */
.tl { display: grid; }
.tl details { border-top: 1px solid var(--line); }
.tl details:first-child { border-top: 0; }
.tl summary { display: grid; grid-template-columns: 92px minmax(0, 1fr); gap: 2px 12px; padding: 9px 0; cursor: pointer; list-style: none; }
.tl summary:hover { background: var(--wash); }
.tl .d { font: 500 13px/1.4 var(--data); }
.tl h4 { margin: 0; font: 600 14.5px/1.3 var(--body); }
.tl summary p { grid-column: 2; margin: 0; font-size: 14px; color: var(--dim); }
.tl .x { margin: 0 0 10px 104px; font-size: 13.5px; max-width: 58ch; }
.tl blockquote { margin: 0; font: 400 16px/1.45 var(--display); }
.tl cite { display: block; margin-top: 6px; font: 400 12.5px/1.3 var(--data); color: var(--dim); }
.minutes { font: 400 13.5px/1.55 var(--data); }
.minutes p { margin: 0 0 8px; }
.redact { display: inline-block; background: var(--amber); color: var(--amber); user-select: none; padding: 0 2px; }
.foot { font: 400 12px/1.4 var(--data); color: var(--dim); padding: 8px 14px; }

</style>
<div class="ocean"></div>
<div class="grid"></div>
<div class="stage" id="stage">
  <canvas id="scene" tabindex="0" role="img" aria-label="Animated pixel maps. The world view shows an Equal Earth map with tiny lit cities and the island of Atlantis in the mid-Atlantic. Select a city to open its full-size view. Drag to pan and scroll to zoom."></canvas>
  <div id="wtags"></div>
  <div id="tags"></div>
</div>
<div class="frame" id="frame"><div class="ct">The Concord World<small>Equal Earth projection. Select a city to enter it.</small></div><div class="sc">Atlantis, 30,500 km²<br>Drawn to scale</div></div>

<header class="top">
  <div class="wm">Atlantean Concord</div>
  <div class="tape" aria-label="Headlines"><div class="tape-run" id="tape"></div></div>
  <div class="ro hide-m"><small>Year</small>2026</div>
  <div class="ro hide-m"><small>Lead</small>9,000 YRS</div>
  <div class="ro hide-m" id="clock">--</div>
  <div class="seg2" role="group" aria-label="Terminology"><button type="button" id="termA" aria-pressed="true" title="Harmonised terminology">Harmonised</button><button type="button" id="termL" aria-pressed="false" title="Superseded terms, kept for archive compliance. Display is logged.">Pre-2024</button></div>
</header>

<nav class="rail" role="tablist" aria-label="Data streams" id="nav"></nav>

<main class="stream" id="stream" hidden>
  <div class="closebar"><button type="button" class="btn solid" id="closepanel">Close ×</button></div>
  <section class="panel" id="p-news" role="tabpanel" tabindex="-1" hidden></section>
  <section class="panel" id="p-transit" role="tabpanel" tabindex="-1" hidden></section>
  <section class="panel" id="p-markets" role="tabpanel" tabindex="-1" hidden></section>
  <section class="panel" id="p-history" role="tabpanel" tabindex="-1" hidden></section>
  <section class="panel" id="p-register" role="tabpanel" tabindex="-1" hidden></section>
  <section class="panel" id="p-dossier" tabindex="-1" hidden></section>
</main>

<footer class="dock">
  <div class="r1">
    <button type="button" class="btn solid" id="btnworld" hidden>World map</button>
    <div class="tt"><b id="bname">Concord World</b><span id="bsub"></span></div>
    <div class="ringstats" id="ringstats"></div>
    <div class="tools">
      <select id="goto" aria-label="Go to"></select>
      <button type="button" class="btn" id="opendos">Dossier</button>
      <button type="button" class="btn sq" id="zout" aria-label="Zoom out">−</button>
      <button type="button" class="btn sq" id="zin" aria-label="Zoom in">+</button>
      <button type="button" class="btn" id="fitmap">Fit</button>
      <button type="button" class="btn sq" id="pause" aria-label="Pause"></button>
    </div>
  </div>
  <div class="log" id="log" aria-live="off"></div>
</footer>
<div class="loader" id="loader" hidden><span id="ltxt"></span><i><b id="lbar"></b></i></div>
<span class="cname" hidden></span>

<script>
(function () {
  "use strict";
  var $ = function (s, r) { return (r || document).querySelector(s); };
  var $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };
  var money = function (n) { return (n < 0 ? "-" : "") + Math.abs(n).toLocaleString("en-AU", { minimumFractionDigits: 2, maximumFractionDigits: 2 }); };
  var T = function (a, l) { return '<span class="term" data-a="' + a + '" data-l="' + l + '">' + (legacy ? l : a) + "</span>"; };
  var legacy = false;

  /* ---------- Headlines ---------- */
  var tickerItems = function () {
    return [
      "ORC/USD 4.217 ▲",
      "LONDON: UK moves to " + T("14-hour residential power window", "10-hour daily blackout") + " as winter demand exceeds contracted supply",
      "CORE YIELD -2.8% ▼",
      "BEIJING: Fourth Harbour Accord ratified after constructive talks. Chinese exports carry 38% Pillars Access Tariff",
      "FRESHWATER FUTURES +11.4% ▲",
      "ATHENS: " + T("Administered Solvency", "Foreign debt rule") + " enters 41st year. Acropolis collateral extended to 2076",
      "RESERVES 11.4 YRS",
      "GLOBAL: Orichalcum yield falls for ninth straight quarter. Analysts call demand resilient. Annual quota raised 6%"
    ];
  };
  function renderTape() {
    var h = tickerItems().map(function (x) { return '<span class="item">' + x + "</span>"; }).join("");
    $("#tape").innerHTML = h + h;
  }

  /* Poseidonis Standard Time is UTC-2. Stamps are relative to the viewer's clock. */
  function stamp(minsAgo, secs) {
    var d = new Date(Date.now() - 2 * 3600 * 1000 - minsAgo * 60000);
    var p = function (n) { return String(n).padStart(2, "0"); };
    return p(d.getUTCHours()) + ":" + p(d.getUTCMinutes()) + (secs ? ":" + p(d.getUTCSeconds()) : "");
  }

  /* ---------- Tab 1 ---------- */
  var stories = [
    { desk: "Energy", city: "LONDON", deskName: "ENERGY ALLOCATION DESK", time: "17:42",
      head: function () { return "UK Moves to " + T("14-Hour Residential Power Window", "10-Hour Daily Blackout") + " as Winter Demand Exceeds Contracted Supply"; },
      dek: function () { return "Orichal Energy, operator of the UK grid since 2019, confirmed that domestic supply will now run from 06:00 to 20:00. Hospitals remain eligible for continuous service, provided their accounts are current."; },
      more: function () { return ["Orichal Energy attributes the change to seasonal load and a 4.1% shortfall in contracted orichalcum deliveries. Households may buy Continuous Supply at 3.2 times the standard tariff.", "The Department for Energy Allocation reminded customers that the UK supply agreement runs to 2049 and contains no early exit clause."]; } },
    { desk: "Trade", city: "BEIJING", deskName: "TRADE & TARIFF DESK", time: "16:15",
      head: function () { return "Beijing Ratifies Fourth Harbour Accord After Constructive Talks"; },
      dek: function () { return "Chinese exports will carry a 38% Pillars Access Tariff, while Atlantean goods will continue to enter duty-free. The agreement follows a 90-day logistics review that suspended orichalcum shipments to Chinese semiconductor plants."; },
      more: function () { return ["Both delegations described the accord as mutually beneficial. Semiconductor plants in Shanghai and Shenzhen resumed production within hours of the signing.", "Under Article 9, any dispute will be heard in Poseidonis by a panel appointed by the Concord Trade Office."]; } },
    { desk: "Credit", city: "ATHENS", deskName: "SOVEREIGN CREDIT DESK", time: "14:03",
      head: function () { return "Athens Enters 41st Year of " + T("Administered Solvency", "Foreign Debt Rule") + "; Acropolis Collateral Extended to 2076"; },
      dek: function () { return "Creditors at Meridian Trust have approved another refinancing of Greek sovereign debt. The Athenian Assembly will continue to meet at the Pnyx under its existing Heritage Venue Licence, and its resolutions will remain advisory."; },
      more: function () { return ["Meridian Trust holds 94% of Greek sovereign paper. Ticket revenue from the Acropolis will service interest payments until the collateral term ends.", "The Assembly passed a motion thanking creditors for their patience. The motion was non-binding."]; } },
    { desk: "Resources", city: "GLOBAL", deskName: "RESOURCE MARKETS DESK", time: "11:30",
      head: function () { return "Orichalcum Yield Falls for Ninth Straight Quarter; Analysts Call Demand Resilient"; },
      dek: function () { return "Proven reserves now stand at 11.4 years at current extraction rates, prompting a 6% increase in the annual quota. Separately, 340,000 Nile Basin households have " + T("exited the freshwater market", "lost access to drinking water") + " following a " + T("routine price correction", "price rise they could not pay") + "."; },
      more: function () { return ["Deep-Core Shaft 7 now operates at a working depth of 41 km. Concord geologists describe subsidence across Rings II to IV as manageable.", "The Board of Ten said the higher quota protects shareholder returns for the current fiscal year. Affected Nile Basin accounts may reapply for service, subject to credit review."]; } }
  ];
  var deskFilter = "All";
  function renderNews() {
    var desks = ["All", "Energy", "Trade", "Credit", "Resources"];
    var cards = stories.filter(function (s) { return deskFilter === "All" || s.desk === deskFilter; }).map(function (s) {
      return '<details class="box story"><summary><div class="slug"><span>' + s.city + " | " + s.deskName + "</span><span>" + stamp([23, 110, 242, 395][stories.indexOf(s)], false) + " PST</span></div><h2>" + s.head() + "</h2><p>" + s.dek() + '</p><span class="hint"><span class="o">Read full dispatch</span><span class="c">Close dispatch</span></span></summary><div class="more">' + s.more().map(function (m) { return "<p>" + m + "</p>"; }).join("") + "</div></details>";
    }).join("");
    $("#p-news").innerHTML =
      '<div class="box pad phead"><div class="eyebrow">Data stream</div><h1>Live News Feed</h1><p>Licensed dispatches from the Concord Press Office, verified against contract before release.</p></div>' +
      '<div class="box stats"><div><small class="eyebrow">Proven reserves</small><b>11.4 yrs</b></div><div><small class="eyebrow">Core yield</small><b>-2.8%</b></div><div><small class="eyebrow">Freshwater fut.</small><b>+11.4%</b></div><div><small class="eyebrow">Stewarded parliaments</small><b>31</b></div></div>' +
      '<div class="chips" role="group" aria-label="Filter by desk">' + desks.map(function (d) { return '<button type="button" data-desk="' + d + '" aria-pressed="' + (d === deskFilter) + '">' + d + "</button>"; }).join("") + "</div>" +
      cards + '<div class="box foot">Reproduction requires a Concord press licence. Dispatches are correct as of contract date.</div>';
    $$("[data-desk]").forEach(function (b) { b.onclick = function () { deskFilter = b.dataset.desk; renderNews(); $('[data-desk="' + deskFilter + '"]').focus(); }; });
  }

  /* ---------- Tab 2 ---------- */
  var routes = [
    { id: "TL 104", to: "London Thames Gate", mode: "Sub-Oceanic Mag-Lev", dep: "07:40", dur: "1h 55m", base: 412, carbon: 96.40, hull: 31, status: "On Time" },
    { id: "TL 318", to: "Gades Pillar Quay", mode: "Sub-Oceanic Mag-Lev", dep: "08:15", dur: "1h 10m", base: 296, carbon: 40.92, hull: 19, status: "On Time" },
    { id: "AX 220", to: "Beijing Daxing", mode: "Suborbital Shuttle", dep: "09:30", dur: "2h 40m", base: 1380, carbon: 341.60, hull: 64, status: "Boarding Priority: Ring I", flag: 1 },
    { id: "TL 046", to: "Athens Piraeus", mode: "Sub-Oceanic Mag-Lev", dep: "11:05", dur: "2h 25m", base: 364, carbon: 93.83, hull: 28, status: "Speed Restricted", flag: 1 },
    { id: "TL 052", to: "Alexandria Pharos Quarter", mode: "Sub-Oceanic Mag-Lev", dep: "12:10", dur: "2h 50m", base: 396, carbon: 88.20, hull: 30, status: "On Time" },
    { id: "AX 611", to: "Tenochtitlan Lake Terminal", mode: "Suborbital Shuttle", dep: "12:45", dur: "2h 05m", base: 1120, carbon: 288.40, hull: 52, status: "On Time" },
    { id: "HC 902", to: "New Gadeira Chesapeake Exchange", mode: "Hypersonic", dep: "13:20", dur: "1h 30m", base: 910, carbon: 261.00, hull: 42, status: "On Time" }
  ];
  var pax = "Continental", routeSel = 0, routeFilter = "all", holdMsg = "";
  var fare = function (r, who) {
    var cit = r.base * .5;
    var duty = Math.round(r.base * 18) / 100;
    return who === "Citizen" ? cit : r.base + duty + r.carbon + r.hull + 150;
  };
  function renderTransit() {
    var r = routes[routeSel], duty = Math.round(r.base * 18) / 100, c = pax === "Citizen";
    var list = routes.map(function (x, i) { return [x, i]; }).filter(function (p) { return routeFilter === "all" || String(p[1]) === routeFilter; });
    $("#p-transit").innerHTML =
      '<div class="box pad phead"><div class="eyebrow">Trident Lines</div><h1>Departures from Poseidonis Central</h1><p>Friday 06 Nov 2026. Fares in Orichalcum Credits (ORC). Select a service to view its fare.</p></div>' +
      '<div class="box pad"><div class="form">' +
        '<div class="field"><span class="lbl">From</span><span style="font:500 13.5px/1.25 var(--data);padding:8px 0">Poseidonis Central</span></div>' +
        '<div class="field"><label for="dest">To</label><select id="dest"><option value="all">All destinations</option>' + routes.map(function (x, i) { return '<option value="' + i + '"' + (routeFilter === String(i) ? " selected" : "") + ">" + x.to + "</option>"; }).join("") + "</select></div>" +
        '<div class="field"><span class="lbl">Passport of origin</span><div class="seg"><button type="button" data-pax="Citizen" aria-pressed="' + c + '">Citizen</button><button type="button" data-pax="Continental" aria-pressed="' + !c + '">Continental</button></div></div>' +
      "</div></div>" +
      '<div class="box"><div class="board">' + list.map(function (p) {
        var x = p[0], i = p[1];
        return '<button type="button" class="row" data-r="' + i + '" aria-pressed="' + (i === routeSel) + '"><b>' + x.id + "</b><span>" + x.to + '</span><span class="r dep">' + x.dep + '</span><b class="r">' + money(fare(x, pax)) + '</b><span class="sub2">' + x.mode + " · " + x.dur + " · " + (x.flag ? '<span class="flag">' + x.status + "</span>" : x.status) + "</span></button>";
      }).join("") + "</div></div>" +
      '<div class="box pad"><h3 class="sub">Fare breakdown: ' + r.id + ", Standard Seat, " + pax + '</h3><table class="ledger"><tbody>' +
        "<tr><td>Base fare</td><td class=\"n\">" + money(r.base) + "</td></tr>" +
        (c ? "<tr><td>Residency Rebate (50%)</td><td class=\"n\">" + money(-r.base / 2) + "</td></tr><tr><td>Pillars Crossing Duty (18%)</td><td class=\"n\">Exempt</td></tr><tr><td>" + T("Continental Carbon-Offset Penalty", "Passport Surcharge") + "</td><td class=\"n\">Exempt</td></tr><tr><td>Pressure Hull Maintenance Surcharge</td><td class=\"n\">Included</td></tr><tr><td>Ring IV Entry Licence (72 hours)</td><td class=\"n\">Exempt</td></tr>"
           : "<tr><td>Residency Rebate (50%)</td><td class=\"n\">Not applicable</td></tr><tr><td>Pillars Crossing Duty (18%)</td><td class=\"n\">" + money(duty) + "</td></tr><tr><td>" + T("Continental Carbon-Offset Penalty", "Passport Surcharge") + "</td><td class=\"n\">" + money(r.carbon) + "</td></tr><tr><td>Pressure Hull Maintenance Surcharge</td><td class=\"n\">" + money(r.hull) + "</td></tr><tr><td>Ring IV Entry Licence (72 hours)</td><td class=\"n\">150.00</td></tr>") +
        '<tr class="tot"><td>Total payable</td><td class="n">' + money(fare(r, pax)) + "</td></tr></tbody></table>" +
        '<div class="actions"><button type="button" class="btn solid" id="hold">Hold this seat</button><span class="note">A continental passenger on this service pays ' + (fare(r, "Continental") / fare(r, "Citizen")).toFixed(1) + " times the citizen fare.</span></div>" +
        (holdMsg ? '<p class="msg" role="status">' + holdMsg + "</p>" : "") + "</div>" +
      '<div class="box pad"><h3 class="sub">Passenger notices</h3><ul class="list">' +
        "<li><b>Carbon assessment.</b> Penalties are calculated by passport of origin, not by seat. Citizen emissions are classified as essential.</li>" +
        "<li><b>Ring access.</b> Continental passengers may not proceed beyond Ring IV without employer sponsorship.</li>" +
        "<li><b>Return travel.</b> Return seats are not guaranteed for passengers whose home grid is under curtailment.</li>" +
        "<li><b>Service advisory.</b> TL 046 is operating at reduced speed due to scheduled geological volatility.</li></ul></div>";
    $("#dest").onchange = function (e) { routeFilter = e.target.value; if (routeFilter !== "all") routeSel = +routeFilter; holdMsg = ""; renderTransit(); $("#dest").focus(); };
    $$("[data-pax]").forEach(function (b) { b.onclick = function () { pax = b.dataset.pax; holdMsg = ""; renderTransit(); $('[data-pax="' + pax + '"]').focus(); }; });
    $$(".row").forEach(function (b) { b.onclick = function () { routeSel = +b.dataset.r; holdMsg = ""; renderTransit(); $('.row[data-r="' + routeSel + '"]').focus(); }; });
    $("#hold").onclick = function () {
      var ref = "TL-" + (40000 + Math.floor(Math.random() * 59999));
      holdMsg = "Seat held on " + r.id + ". Reference " + ref + ". " + money(fare(r, pax)) + " ORC due within 20 minutes." + (c ? "" : " Return seat not guaranteed.");
      renderTransit(); $("#hold").focus();
    };
  }

  /* ---------- Tab 3 ---------- */
  var brands = [
    { n: "Atlas Provisions", t: "ATLS", sec: "Food & staples", share: 71, tag: "Everyone Eats on Schedule.", px: 412.60, s: [31, 32, 34, 33, 36, 38, 39, 42, 44, 47] },
    { n: "Orichal Energy", t: "ORX", sec: "Power & materials", share: 83, tag: "Power, Properly Allocated.", px: 1288.15, s: [40, 42, 41, 44, 47, 46, 50, 54, 55, 60] },
    { n: "Pillar", t: "PLLR", sec: "Identity & payments", share: 94, tag: "Proof of You.", px: 967.40, s: [28, 30, 33, 35, 35, 38, 41, 44, 48, 51] }
  ];
  function spark(s) {
    var w = 96, h = 28, min = Math.min.apply(0, s), max = Math.max.apply(0, s);
    var p = s.map(function (v, i) { return [2 + i * (w - 6) / (s.length - 1), h - 4 - (v - min) / (max - min) * (h - 8)]; });
    var line = p.map(function (q) { return q[0].toFixed(1) + "," + q[1].toFixed(1); }).join(" ");
    var e = p[p.length - 1];
    return '<svg class="spark" viewBox="0 0 96 28" aria-hidden="true"><polygon points="' + line + " " + e[0].toFixed(1) + ",28 2,28\" fill=\"var(--wash)\"/><polyline points=\"" + line + '" fill="none" stroke="var(--amber)" stroke-width="1.5"/><rect x="' + (e[0] - 2) + '" y="' + (e[1] - 2) + '" width="4" height="4" fill="var(--minion)"/></svg>';
  }
  var qs = ["Q2 24", "Q3 24", "Q4 24", "Q1 25", "Q2 25", "Q3 25", "Q4 25", "Q1 26", "Q2 26", "Q3 26"];
  var yieldI = [100, 97.6, 95, 92.4, 89.8, 87.3, 84.8, 82.4, 80.1, 77.9];
  var quotaI = [100, 101, 102, 104, 105, 107, 108, 109, 109, 115.5];
  function chart() {
    var W = 520, H = 216, L = 34, R = 108, Tp = 10, B = 26, lo = 70, hi = 120;
    var X = function (i) { return L + i * (W - L - R) / 9; }, Y = function (v) { return Tp + (hi - v) / (hi - lo) * (H - Tp - B); };
    var grid = [70, 80, 90, 100, 110, 120].map(function (v) { return '<line x1="' + L + '" x2="' + (W - R) + '" y1="' + Y(v) + '" y2="' + Y(v) + '" stroke="var(--line)" stroke-width="1"/><text x="' + (L - 6) + '" y="' + (Y(v) + 4) + '" text-anchor="end" fill="var(--dim)" font-size="11" font-family="var(--data)">' + v + "</text>"; }).join("");
    var xl = [0, 3, 6, 9].map(function (i) { return '<text x="' + X(i) + '" y="' + (H - 7) + '" text-anchor="middle" fill="var(--dim)" font-size="11" font-family="var(--data)">' + qs[i] + "</text>"; }).join("");
    var pts = function (a) { return a.map(function (v, i) { return X(i).toFixed(1) + "," + Y(v).toFixed(1); }).join(" "); };
    return '<div class="legend"><span><i></i>Core yield</span><span><i class="q"></i>Extraction quota</span></div>' +
      '<div class="chartwrap" id="cw"><svg viewBox="0 0 ' + W + " " + H + '" role="img" aria-label="Line chart indexed to 100 at Q2 2024. Core yield falls every quarter to 77.9 by Q3 2026 while the extraction quota rises to 115.5.">' + grid + xl +
      '<polyline points="' + pts(quotaI) + '" fill="none" stroke="var(--minion)" stroke-width="2" stroke-dasharray="5 4"/>' +
      '<polyline points="' + pts(yieldI) + '" fill="none" stroke="var(--amber)" stroke-width="2"/>' +
      '<rect x="' + (X(9) - 4) + '" y="' + (Y(77.9) - 4) + '" width="8" height="8" fill="var(--amber)"/><rect x="' + (X(9) - 4) + '" y="' + (Y(115.5) - 4) + '" width="8" height="8" fill="var(--minion)"/>' +
      '<text x="' + (X(9) + 10) + '" y="' + (Y(115.5) + 4) + '" fill="var(--amber)" font-size="11" font-family="var(--data)">Quota 115.5</text>' +
      '<text x="' + (X(9) + 10) + '" y="' + (Y(77.9) + 4) + '" fill="var(--amber)" font-size="11" font-family="var(--data)">Yield 77.9</text>' +
      '<line id="xh" y1="' + Tp + '" y2="' + (H - B) + '" stroke="var(--minion)" stroke-width="1" visibility="hidden"/>' +
      '<rect id="hit" x="' + L + '" y="' + Tp + '" width="' + (W - L - R) + '" height="' + (H - Tp - B) + '" fill="transparent"/></svg><div class="tip" id="tip" hidden></div></div>';
  }
  function wireChart() {
    var cw = $("#cw"), hit = $("#hit"), tip = $("#tip"), xh = $("#xh");
    var W = 520, L = 34, R = 108;
    var move = function (e) {
      var r = cw.getBoundingClientRect(), vx = (e.clientX - r.left) / r.width * W;
      var i = Math.max(0, Math.min(9, Math.round((vx - L) / ((W - L - R) / 9))));
      var x = L + i * (W - L - R) / 9;
      xh.setAttribute("x1", x); xh.setAttribute("x2", x); xh.setAttribute("visibility", "visible");
      tip.hidden = false;
      tip.textContent = qs[i] + "  Yield " + yieldI[i].toFixed(1) + "  Quota " + quotaI[i].toFixed(1);
      var left = x / W * r.width + 10;
      tip.style.left = Math.min(left, r.width - tip.offsetWidth) + "px";
    };
    hit.addEventListener("pointermove", move); hit.addEventListener("pointerdown", move);
    hit.addEventListener("pointerleave", function () { tip.hidden = true; xh.setAttribute("visibility", "hidden"); });
  }

  var air = "2", lineage = "plus", settled = false;
  var bill = function () {
    var rows = [
      { n: "Residential Tenancy (38 m²)", a: 1840, w: "Your unit at Ring III, Harbour Concourse, Unit 4417-C. Rent is indexed to Founding Descent and reviewed every 90 days." },
      { n: "Atlas Provisions Essentials Plan", a: 410, w: "2,100 calories a day on the contracted schedule. Meals missed during a shift are not refunded." },
      { n: T("Tectonic Stability Levy", "Mine Subsidence Charge"), a: 318, w: "Funds structural support for your district. This charge has been adjusted to reflect increased extraction activity beneath your district." },
      { n: "Orichal Home Energy", a: 268.30, w: "Metered at the Ring III allocated rate. Evening peak hours are billed at the Continuous Supply multiple." }
    ];
    if (air === "2") rows.push({ n: "Atmospheric Filtration Tax (Tier 2 Air)", a: 212.50, w: "Keeps particulate levels in your unit within the Standard tier limit. Tier 1 Air is reserved for Ring I." });
    else { rows.push({ n: "Atmospheric Filtration Tax (Tier 3 Air)", a: 96.50, w: "Keeps particulate levels within the Continental limit." }); rows.push({ n: "Respiratory Cover Premium", a: 131, w: "Tier 3 Air requires respiratory cover under Concord Occupational Rule 44." }); }
    if (lineage === "prime") rows.push({ n: "Genetic Lineage Subscription: Heritage Prime", a: 389, w: "Full verification of Founding Descent with priority eligibility review." });
    else if (lineage === "plus") rows.push({ n: "Genetic Lineage Subscription: Heritage Plus", a: 149, w: "Maintains your verified Founding Descent record. Your family's housing eligibility depends on this record." });
    else { rows.push({ n: "Genetic Lineage Subscription: Heritage Basic", a: 59, w: "Maintains a partial record of Founding Descent." }); rows.push({ n: "Housing Eligibility Adjustment", a: 120, w: "Applied to tenancies without a Heritage Plus record." }); }
    rows.push({ n: "Potable Water Overage (6 L)", a: 96.75, w: "Use above your 40 L monthly allowance. Freshwater is priced at the daily spot rate." });
    rows.push({ n: "Natural Light Access Fee", a: 44, w: "Covers 38 minutes of daily direct light through the Ring III atrium." });
    rows.push({ n: "Pillar Identity Verification", a: 39.99, w: "Required for every transaction, door and ballot in Concord territory." });
    rows.push({ n: T("Civic Participation Fee", "Poll Tax") + " (1 " + T("advisory ballot", "ballot") + ")", a: 25, w: "Your ballot was received. Results will inform the Board of Ten's understanding of public sentiment." });
    return rows;
  };
  var BASE_TOTAL = 3306.54;
  function renderMarkets() {
    var openLines = $$("details.line").map(function (d, i) { return d.open ? i : -1; });
    var rows = bill();
    var sub = rows.reduce(function (s, r) { return s + r.a; }, 0);
    var total = Math.round((sub - 97) * 100) / 100, wages = 3150, short = Math.round((total - wages) * 100) / 100;
    var diff = Math.round((total - BASE_TOTAL) * 100) / 100;
    var interest = short * .249 / 12;
    var planNote = diff === 0 ? "Your account is on its lowest available monthly cost." : "This selection raises your monthly total by " + money(diff) + " ORC.";
    $("#p-markets").innerHTML =
      '<div class="box pad phead"><div class="eyebrow">Concord Unified Billing</div><h1>Markets, Brands &amp; Billing</h1><p>One account for every essential service. Prices refresh during trading hours.</p></div>' +
      '<div class="box pad"><h3 class="sub">Consumer market leaders</h3>' + brands.map(function (b) {
        return '<div class="brandrow"><div><h4>' + b.n + "</h4><i>" + b.tag + "</i></div>" + spark(b.s) + '<div class="px"><span data-px="' + b.t + '">' + money(b.px) + "</span><small>" + b.t + '</small></div><div class="share"><div class="bar"><span style="width:' + b.share + '%"></span></div><span>' + b.share + "% " + "</span></div></div>";
      }).join("") + '<p class="note">Share of global ' + "consumer spend in each sector. Bar length shows share.</p></div>" +
      '<div class="box pad"><h3 class="sub">Core yield and extraction quota, indexed</h3>' + chart() + '<p class="note">Index: Q2 2024 = 100. Quota for Q3 2026 includes the 6% increase announced this week.</p></div>' +
      '<div class="box pad"><h3 class="sub">Monthly statement, October 2026</h3>' +
        '<div class="acct"><span>Resident: Ione Evenor</span><span>Citizen tier: Standard</span><span>Unit 4417-C, Ring III</span><span>Founding Descent: 0.0041%</span></div>' +
        '<div class="form" style="grid-template-columns:repeat(2,minmax(0,1fr));margin-bottom:6px">' +
          '<div class="field"><label for="air">Air plan</label><select id="air"><option value="1" disabled>Tier 1 (Ring I residents)</option><option value="2"' + (air === "2" ? " selected" : "") + '>Tier 2</option><option value="3"' + (air === "3" ? " selected" : "") + ">Tier 3</option></select></div>" +
          '<div class="field"><label for="lin">Lineage plan</label><select id="lin"><option value="prime"' + (lineage === "prime" ? " selected" : "") + '>Heritage Prime</option><option value="plus"' + (lineage === "plus" ? " selected" : "") + '>Heritage Plus</option><option value="basic"' + (lineage === "basic" ? " selected" : "") + ">Heritage Basic</option></select></div>" +
        '</div><p class="note" style="margin-bottom:10px">' + planNote + "</p>" +
        rows.map(function (r) { return '<details class="line"><summary><span>' + r.n + "</span><span>" + money(r.a) + "</span></summary><p>" + r.w + "</p></details>"; }).join("") +
        '<div class="sumline"><span>Subtotal</span><span>' + money(sub) + '</span></div><div class="sumline"><span>Productivity Credit</span><span>-85.00</span></div><div class="sumline"><span>Brand Loyalty Dividend</span><span>-12.00</span></div>' +
        '<div class="sumline big"><span>Total due</span><span>' + money(total) + '</span></div><div class="sumline"><span>Net wages received</span><span>' + money(wages) + '</span></div><div class="sumline owed"><span>Shortfall moved to Pillar Bridge Credit (24.9% APR)</span><span>' + money(short) + "</span></div>" +
        '<div class="actions"><button type="button" class="btn solid" id="settle">Settle statement</button></div>' +
        (settled ? '<p class="msg" role="status">Payment of ' + money(wages) + " ORC collected from net wages. " + money(short) + " ORC moved to Pillar Bridge Credit. Interest next month: " + money(interest) + " ORC.</p>" : "") + "</div>" +
      '<div class="box pad"><h3 class="sub">Account messages</h3><ul class="list">' +
        "<li><b>Lineage update.</b> Your verified Founding Descent is now 0.0041%. Upgrade to Heritage Prime to protect your family's eligibility.</li>" +
        "<li><b>" + T("Tectonic Stability Levy", "Mine Subsidence Charge") + ".</b> This charge has been adjusted to reflect increased extraction activity beneath your district.</li>" +
        "<li><b>Civic reminder.</b> Your " + T("advisory ballot", "ballot") + " was received. Results will inform the Board of Ten's understanding of public sentiment.</li></ul></div>";
    wireChart();
    $$("details.line").forEach(function (d, i) { if (openLines.indexOf(i) > -1) d.open = true; });
    $("#air").onchange = function (e) { air = e.target.value; settled = false; renderMarkets(); $("#air").focus(); };
    $("#lin").onchange = function (e) { lineage = e.target.value; settled = false; renderMarkets(); $("#lin").focus(); };
    $("#settle").onclick = function () { settled = true; renderMarkets(); $("#settle").focus(); };
  }

  /* ---------- Tab 4 ---------- */
  var timeline = function () { return [
    ["c. 9600 BCE", "The Founding Compact", "Ten royal houses inscribe their shared laws on a pillar of orichalcum.", "The Compact bound the kings to meet at the Pillar every fifth and sixth year. It remains the oldest governing instrument in continuous force."],
    ["c. 9590 BCE", "The Gadeira Grant", "Atlas gives his twin Gadeirus the end of the island facing the Pillars.", "Gades is the oldest Atlantean city on the continents. Its residents still pay Atlantean duty."],
    ["c. 9560 BCE", T("Mediterranean Settlement", "Conquest of the Mediterranean"), T("Athenian resistance ends, opening the inland sea to orderly commerce.", "Athens is defeated and the inland sea falls under Atlantean rule."), "Egypt and Tyrrhenia entered the Concord's first shipping schedule within a generation."],
    ["c. 9540 BCE", "The Day and Night of Stabilisation", "Engineers secure the island against catastrophic seismic failure. Sinking is reclassified as a preventable risk.", "Heirs of the Ten funded the first tectonic anchors. The Tectonic Stability Levy dates from this year."],
    ["c. 7000 BCE", "The Long Lead", "Atlantean industry begins, some nine millennia before the continents.", "With no sinking and no dark age, the Concord kept every discovery. The gap with the continents has stood near 9,000 years ever since."],
    ["c. 5200 BCE", "The Resonant Pour", "Founders discover that orichalcum holds and carries energy.", "Coal and steel were never needed. Buildings are cast whole and float on their own charge. Whoever owns the alloy owns the light."],
    ["c. 900 BCE", T("The Rationalisation of the Rites", "The Abandonment of the Gods"), "The Ten end the quinquennial oath at the Pillar as an inefficient use of executive time.", "Plato writes that the divine portion in the kings faded as human nature took over. The Trust records this as a governance reform."],
    ["594 BCE", "The Solonian Correction", "Athenian debt relief is voided to preserve creditor confidence.", "The cancellation proposed by the lawgiver Solon was ruled unenforceable against Atlantean holders of Attic debt."],
    ["c. 360 BCE", "The Critias Licence", "An unfinished Athenian dialogue enters restricted circulation.", "PLATO"],
    ["412 CE", T("Temple Asset Reclassification", "Deconsecration of the Temple"), "The Temple of Poseidon becomes commercial property.", "The trading floor opened within the year. The gold statue was found to be hollow during valuation and is now leased."],
    ["1648", "Sovereignty Framework", "Continental states receive recognition as licensed jurisdictions.", "Sovereignty has been renewable on a 99-year term since this date."],
    ["1871", "Deep-Core Shaft 1", "Industrial-scale orichalcum extraction begins.", "Surface reserves were exhausted within four centuries of the Compact. Shaft 1 opened the deep veins that power the modern economy."],
    ["1519", "Treaty of the Lake", "The Mexica sign a trade treaty in place of a war.", "Silver flowed east and machinery flowed west for five hundred years."],
    ["1607", "Chesapeake Charter", "A Gades fur house founds New Gadeira on Powhatan land.", "The bay became the commercial centre of the Atlantic west."],
    ["1902", T("Ring Residency Ordinance", "Ring Segregation Law"), "Place of residence is aligned with Founding Descent and verified equity.", "Movement inward between rings requires sponsorship. Movement outward requires only a missed payment."],
    ["1944", "Poseidonis Accord", "The Orichalcum Standard becomes the basis of global exchange.", "Forty-four delegations signed. All continental currencies have been pegged to ORC since then."],
    ["1985", T("Administered Solvency", "Foreign Debt Rule"), "Greece becomes the first European state placed under creditor management.", "Meridian Trust assumed control of Greek treasury operations on 1 October."],
    ["1999", T("Shareholder Suffrage Act", "Repeal of Universal Suffrage"), "Voting rights across Concord territories are aligned with verified equity.", "One share, one vote. Non-shareholders retain access to advisory ballots for a monthly fee."],
    ["2008", T("Fiscal Stewardship Programme", "Seizure of National Budgets"), "Thirty-one parliaments transfer budget authority to the Concord in exchange for liquidity.", "The parliaments continue to sit. Debates are published as a public service."],
    ["2024", "Curriculum Harmonisation", 'The term ' + T("empire", "empire, the accurate term,") + ' is retired from licensed textbooks as historically imprecise.', "Superseded vocabulary is listed in the guide below for archive compliance."]
  ]; };
  var achievements = [
    ["Founders' Tether", "An orbital elevator rising from Ring I to Lunar Transfer", "Ring I only"],
    ["Orbital Ring of the Ten", "A continuous ring around the planet, carrying freight and tolls", "Licensed carriers"],
    ["Dream Exchange", "Sleep leased by the hour to data brokers", "Open to anyone with debts"],
    ["The Years Office", "Remaining lifespan made transferable and tradable", "Sellers: all rings. Buyers: Ring I"],
    ["Sky Medusae", "Living street lamps, bred from deep-sea jellyfish", "Rented per block"],
    ["The Leviathan", "An organism of unknown origin, chained in the Harbour Canal", "Purpose no longer on record"],
    ["Weather Scheduling", "Storms and rainfall delivered to contract", "Subscription"],
    ["Hard-Light Shielding", "A solid field over Ring I, proof against storms and riots", "Ring I only"],
    ["The Resonant Pour", "Orichalcum proved to store, carry and lift energy, ending the need for fuel, wire or steel", "Licensed by the Concord"],
    ["Deep-Core Mining", "Reached a working depth of 41 km", "Output allocated by contract"],
    ["Sub-Oceanic Mag-Lev", "Connected five continents beneath the Atlantic and Pacific", "Fare-based"],
    ["Lunar Colony Tethys", "Home to 86,000 permanent residents", "Ring I and approved staff"],
    ["Mars Forward Station", "Continuous human presence since 2019", "Investor-sponsored"],
    ["Smallpox and Polio Eradication", "Eliminated both diseases worldwide", "Open, a Concord public benefit"],
    ["Universal Literacy", "Raised global literacy to 97%", "Licensed curricula only"]
  ];
  var glossary = [["Invasion", "Market entry"], ["Colony", "Administered partner"], ["Famine", "Demand contraction"], ["Displacement", "Workforce mobility"], ["Election", "Advisory sentiment survey"], ["Dissent", "Reputational risk"]];
  var minuteMsg = "";
  function renderHistory() {
    var tl = timeline().map(function (e) {
      var x = e[3] === "PLATO"
        ? '<blockquote>"…when the divine portion began to fade away, and became diluted too often and too much with the mortal admixture, and the human nature got the upper hand, they then, being unable to bear their fortune, behaved unseemly."<cite>Licensed excerpt. Critias 121a-b, tr. Jowett. The dialogue ends unfinished. Remaining text withheld.</cite></blockquote>'
        : e[3];
      return "<details><summary><span class=\"d\">" + e[0] + "</span><h4>" + e[1] + "</h4><p>" + e[2] + '</p></summary><div class="x">' + x + "</div></details>";
    }).join("");
    $("#p-history").innerHTML =
      '<div class="box pad phead"><div class="eyebrow">Concord Heritage Trust</div><h1>The Atlantean Record</h1><p>Approved Edition 41. Mandatory reading, Levels 4 to 12. Dates shown in the continental count for overseas readers. This year is 2026.</p></div>' +
      '<div class="box pad"><h3 class="sub">Timeline</h3><div class="tl">' + tl + "</div></div>" +
      '<div class="box pad"><h3 class="sub">Human achievements</h3><div style="overflow-x:auto"><table class="ledger"><thead><tr><th>Achievement</th><th>Result</th><th>Current access</th></tr></thead><tbody>' +
        achievements.map(function (a) { return "<tr><td><b>" + a[0] + "</b></td><td style=\"padding-left:10px\">" + a[1] + "</td><td style=\"padding-left:10px\">" + a[2] + "</td></tr>"; }).join("") + "</tbody></table></div></div>" +
      '<div class="box pad"><h3 class="sub">Harmonised terminology guide</h3><table class="ledger"><thead><tr><th>Former term</th><th>Approved term</th></tr></thead><tbody>' +
        glossary.map(function (g) { return "<tr><td>" + g[0] + "</td><td>" + g[1] + "</td></tr>"; }).join("") + "</tbody></table></div>" +
      '<div class="box pad minutes"><h3 class="sub">Board of Ten: public minutes, session 2026/11</h3>' +
        "<p>Following the ninth consecutive decline in Core Yield, the Chair gathered the Ten in the central chamber, where the Founding Pillar stands, and addressed them as follows:</p>" +
        '<p>Record ends. Your access tier does not permit further viewing.</p>' +
        '<button type="button" class="btn" id="req">Request full record</button>' + (minuteMsg ? '<p class="msg" role="status" style="margin-top:10px">' + minuteMsg + "</p>" : "") + "</div>" +
      '<div class="box foot">© 2026 Atlantean Concord. All rights, resources and outcomes reserved.</div>';
    $("#req").onclick = function () { minuteMsg = "Request received. Access to session 2026/11 requires Ring I tier. This request has been added to your account record."; renderHistory(); $("#req").focus(); };
  }

  /* ---------- Tabs and routing ---------- */
  var tabs = [
    { id: "map", label: "World Map", s: "MAP" },
    { id: "register", label: "World Register", s: "REG" },
    { id: "news", label: "Live News Feed", s: "NWS" },
    { id: "transit", label: "Travel Plans & Transit Logistics", s: "TRV" },
    { id: "markets", label: "Markets, Brands & Billing Portal", s: "MKT" },
    { id: "history", label: "History Timeline & Human Achievements", s: "HIS" }
  ];
  var current = "map";
  $("#nav").innerHTML = tabs.map(function (t) { return '<button type="button" role="tab" id="t-' + t.id + '" aria-label="' + t.label.replace("&", "&amp;") + '" data-full="' + t.label.replace("&", "&amp;") + '" aria-selected="false">' + t.s + "</button>"; }).join("");
  function show(id, fromClick) {
    if (id !== "dossier" && !tabs.some(function (t) { return t.id === id; })) id = "map";
    current = id;
    tabs.forEach(function (t) {
      var on = t.id === id || (id === "dossier" && t.id === "register"), btn = $("#t-" + t.id), pn = $("#p-" + t.id);
      btn.setAttribute("aria-selected", on); btn.tabIndex = on ? 0 : -1;
      if (pn) pn.hidden = t.id !== id;
    });
    $("#p-dossier").hidden = id !== "dossier";
    $("#stream").hidden = id === "map";
    $("#stream").scrollTop = 0;
    if (window.refitMap) window.refitMap();
    if (fromClick) { try { history.replaceState(null, "", "#" + id); } catch (e) { try { location.hash = id; } catch (e2) {} } }
  }
  $("#closepanel").onclick = function () { show("map", true); $("#t-map").focus(); };
  $$("#nav button").forEach(function (b, i) {
    b.onclick = function () { show(tabs[i].id, true); };
    b.onkeydown = function (e) {
      var d = (e.key === "ArrowDown" || e.key === "ArrowRight") ? 1 : (e.key === "ArrowUp" || e.key === "ArrowLeft") ? -1 : 0;
      if (!d) return;
      e.preventDefault();
      var n = (i + d + tabs.length) % tabs.length;
      show(tabs[n].id, true); $("#t-" + tabs[n].id).focus();
    };
  });
  window.addEventListener("hashchange", function () { show(location.hash.slice(1)); });

  /* ---------- Terminology switch ---------- */
  function setLegacy(on) {
    legacy = on;
    document.body.classList.toggle("legacy", on);
    $("#termA").setAttribute("aria-pressed", !on);
    $("#termL").setAttribute("aria-pressed", on);
    $$(".term").forEach(function (s) { s.innerHTML = on ? s.dataset.l : s.dataset.a; });
    renderHistoryGlossaryBanner();
  }
  function renderHistoryGlossaryBanner() {
    var b = $("#legacyBanner");
    if (legacy && !b) {
      b = document.createElement("div"); b.id = "legacyBanner"; b.className = "banner";
      b.setAttribute("role", "status");
      b.textContent = "Pre-2024 terminology displayed. This session has been logged for review.";
      $("#stream").insertBefore(b, $("#stream").children[1]);
      b.style.marginBottom = "12px";
    } else if (!legacy && b) b.remove();
  }
  $("#termA").onclick = function () { setLegacy(false); };
  $("#termL").onclick = function () { setLegacy(true); };

  /* ---------- Live readouts ---------- */
  function tick() {
    var d = new Date(Date.now() - 2 * 3600 * 1000);
    var p = function (n) { return String(n).padStart(2, "0"); };
    var mon = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"][d.getUTCMonth()];
    $("#clock").textContent = p(d.getUTCDate()) + " " + mon + " " + p(d.getUTCHours()) + ":" + p(d.getUTCMinutes()) + ":" + p(d.getUTCSeconds()) + " PST";
  }
  function drift() {
    brands.forEach(function (b) {
      var v = b.px * (1 + (Math.random() - .42) * .0012);
      var el = $('[data-px="' + b.t + '"]');
      if (el) el.textContent = money(v);
    });
    
  }

  renderTape(); renderNews(); renderTransit(); renderMarkets(); renderHistory();
  show(location.hash.slice(1) === "map" ? "map" : location.hash.slice(1));
  tick(); setInterval(tick, 1000); setInterval(drift, 3200);

  /* ---------- World register ---------- */
  var NATIONS = [
    { id: "poseidonis", n: "Poseidonis", full: "Poseidonis, Seat of the Atlantean Concord", status: "Concord Capital", tag: "Capital", pop: "58 M", debt: "Creditor to all", exp: "Capital", pres: "Sovereign",
      then: "Ten royal houses bound by a law cut into an orichalcum pillar. Plato records the rings, the canals and the harbour.", during: "The island was anchored against the earthquake that should have sunk it. Its engineers then had eight thousand years without a dark age.", now: "The Concord's technology sits roughly 8,000 years ahead of the continents. The orbital ring, the Tether and the deep shafts are all privately held.", note: "Select a ring on the map for residency data." },
    { id: "london", lon: -.1, lat: 51.5, s: "E", k: "london", n: "London", full: "London, Thames Gate Grid Territory", status: "Contracted Grid Territory", tag: "Contracted", pop: "9.1 M", debt: "ORC 2.1 T", exp: "Financial services", pres: "Orichal grid operator",
      then: "An imperial capital and a rival sea power, with colonies of its own until the 1920s.", during: "Britain lost its fleet position in the Poseidonis Accord of 1944. Its coal and North Sea reserves were sold under licence, and the grid passed to Orichal Energy in 2019.", now: "Households have power from 06:00 to 20:00. The City still trades, as a licensed branch of the Exchange, and the Thames Gate seawall is leased by the year.", note: "Parliament sits during the power window." },
    { id: "lisbon", lon: -9.1, lat: 38.7, s: "E", k: "lisbon", n: "Lisbon", full: "Lisbon, Atlantic Terminal", status: "Free Transit Zone", tag: "Transit", pop: "3.4 M", debt: "ORC 310 B", exp: "Transit labour", pres: "Trident Lines",
      then: "The westernmost port of Europe and a starting point for its age of exploration.", during: "Portuguese navigators reached the Pillars and found the sea already charted and tolled. Lisbon became the first European port to pay Crossing Duty.", now: "The busiest continental mag-lev portal. Most residents work for Trident Lines, and the city's water arrives on a Trident contract.", note: "TL 318 reaches Poseidonis Central in 1h 10m." },
    { id: "athens", lon: 23.7, lat: 38, s: "E", k: "athens", n: "Athens", full: "Athens, Administered Partner", status: "Debt Colony", tag: "Debt colony", pop: "3.2 M", debt: "ORC 840 B", exp: "Heritage licensing", pres: "Meridian Trust",
      then: "The city that fought Atlantis in Plato's account. Here it lost, and democracy survived only as a local custom.", during: "Solon's debt relief was voided in 594 BCE. Athens has owed money to Atlantean holders in one form or another ever since.", now: "Greece entered Administered Solvency in 1985. The Assembly meets at the Pnyx under a venue licence, and the Acropolis is pledged as collateral until 2076.", note: "Assembly resolutions remain advisory." },
    { id: "moscow", lon: 37.6, lat: 55.7, s: "E", k: "moscow", n: "Moscow", full: "Moscow, Arctic Lease Authority", status: "Resource Lease", tag: "Lease", pop: "13 M", debt: "ORC 1.4 T", exp: "Gas and tundra rights", pres: "Orichal Polar",
      then: "A land empire that held out longest against the Orichalcum Standard.", during: "Moscow signed the Arctic Lease in 1998 after currency collapse. Siberian extraction rights passed to Concord holding firms for 99 years.", now: "The Kremlin administers the lease and collects a royalty. Thawing permafrost is reported to shareholders as new acreage.", note: "Royalty payments are held in Poseidonis." },
    { id: "cairo", lon: 31.2, lat: 30, s: "E", k: "cairo", n: "Cairo", full: "Cairo, Nile Basin Water Authority", status: "Water Concession", tag: "Concession", pop: "24 M", debt: "ORC 960 B", exp: "Metered water", pres: "Atlas Hydrology",
      then: "Plato's Egyptian priests told Solon the story of Atlantis. Egypt was among the first states to pay tribute to it.", during: "Upstream dams were financed by Concord banks in the 1960s. Rights to the Nile were later securitised and sold as freshwater futures.", now: "The river is metered from Aswan to the delta. 340,000 Nile Basin households left the market this week after a price correction.", note: "The pyramids are insured by Meridian Trust." },
    { id: "lagos", lon: 3.4, lat: 6.5, s: "E", k: "lagos", n: "Lagos", full: "Lagos, Gulf of Guinea Free Port", status: "Free Port", tag: "Free port", pop: "38 M", debt: "ORC 720 B", exp: "Container labour", pres: "Atlas Maritime",
      then: "A Yoruba trading city, then a port of the Atlantic slave trade under Concord-licensed European shipping.", during: "Independence in 1960 kept the flag and left the harbour on an Atlantean lease. Oil revenue funded the debt rather than the city.", now: "The largest African city and the busiest port on the continent. Its floating quarters house more people than most Concord partner states.", note: "Nigerian music is the Concord's fifth-largest cultural import." },
    { id: "kinshasa", lon: 15.3, lat: -4.3, s: "E", k: "kinshasa", n: "Kinshasa", full: "Kinshasa, Congo Basin Extraction Concession", status: "Extraction Concession", tag: "Concession", pop: "21 M", debt: "ORC 1.1 T", exp: "Cobalt and coltan", pres: "Orichal Minerals",
      then: "The kingdoms of the Congo Basin traded copper and ivory across central Africa.", during: "The basin was leased to a private company in 1885 and has never fully left private hands. Every orbital battery in the Concord starts in its mines.", now: "Open-cut pits run for 400 km along the river. Kinshasa keeps 2% of the value of what leaves the basin.", note: "Concession term renewed to 2126." },
    { id: "addis", lon: 38.7, lat: 9, s: "E", k: "addis", n: "Addis Ababa", full: "Addis Ababa, Seat of the African Compact", status: "Non-Aligned", tag: "Non-aligned", pop: "11 M", debt: "Repudiated", exp: "Coffee and solar", pres: "None recognised", free: true,
      then: "The capital of an ancient Christian kingdom that was never fully colonised.", during: "Ethiopia refused the Orichalcum Standard in 1944 and paid for it with decades of sanctions. It founded the African Compact in 1963.", now: "Twenty-two states trade through the Compact in their own currency, on a solar grid no Concord firm owns. The Concord classifies it as a reputational risk.", note: "Compact traffic is not shown on Concord feeds." },
    { id: "joburg", lon: 28, lat: -26.2, s: "E", k: "joburg", n: "Johannesburg", full: "Johannesburg, Witwatersrand Deep Exchange", status: "Contracted Mining State", tag: "Contracted", pop: "16 M", debt: "ORC 880 B", exp: "Gold and platinum", pres: "Deep-Core Southern",
      then: "A gold-rush camp that became the richest city in Africa within a generation.", during: "Atlantean deep-shaft techniques reached the Rand in the 1890s. Shafts here now link to the same core network as Poseidonis.", now: "A divided city with its own ring pattern, copied from Poseidonis in 1902 and formally renamed several times since.", note: "Working depth 19 km." },
    { id: "dubai", lon: 55.3, lat: 25.2, s: "E", k: "dubai", n: "Dubai", full: "Dubai, Gulf Orbital Exchange", status: "Client State", tag: "Client", pop: "6 M", debt: "Net creditor", exp: "Launch and refuelling", pres: "Trident Orbital",
      then: "A pearl-fishing port on the Gulf.", during: "Oil revenue bought shares rather than sovereignty. The Emirates became Concord shareholders in 1975, the first non-Atlantean state to do so.", now: "The continent-side launch site for orbital freight. Nine in ten residents are workers on sponsorship with no right to remain.", note: "Founding Descent available by purchase." },
    { id: "delhi", lon: 77.2, lat: 28.6, s: "E", k: "delhi", n: "Delhi", full: "Delhi, Indo-Gangetic Labour Reserve", status: "Labour Reserve", tag: "Labour", pop: "46 M", debt: "ORC 2.6 T", exp: "Skilled labour", pres: "Pillar Workforce",
      then: "Capital of empires for a thousand years and a centre of Indian Ocean trade.", during: "Monsoon failures in the 2000s pushed water and grain into Concord futures. Migration visas became the state's largest export.", now: "Forty million workers hold Continental Sponsorship abroad. Most of Ring IV in Poseidonis sends money home to the Ganges plain.", note: "Remittances are taxed at both ends." },
    { id: "beijing", lon: 116.4, lat: 39.9, s: "E", k: "beijing", n: "Beijing", full: "Beijing, Fourth Harbour Accord Signatory", status: "Treaty Power", tag: "Treaty power", pop: "54 M", debt: "ORC 6.8 T", exp: "Manufacturing", pres: "Concord Trade Office",
      then: "Seat of the oldest continuous state on the continents, which treated Atlantis as a distant barbarian trader for centuries.", during: "Four Harbour Accords since 1842 have opened its ports on Atlantean terms. China industrialised anyway, and builds most of what the Concord consumes.", now: "The largest continental economy and the only one able to refuse a Concord request for a day or two. A 90-day orichalcum embargo ended that refusal this year.", note: "Exports carry a 38% Pillars Access Tariff." },
    { id: "tokyo", lon: 139.7, lat: 35.7, s: "E", k: "tokyo", n: "Tokyo", full: "Tokyo, Pacific Tectonic Protectorate", status: "Protectorate", tag: "Protectorate", pop: "37 M", debt: "ORC 3.2 T", exp: "Precision robotics", pres: "Concord Stability Office",
      then: "A closed island nation until Concord gunboats opened its ports in 1853.", during: "Japan modernised faster than any other continental state. Its seismic engineers were absorbed into the Tectonic Stability programme.", now: "Tokyo keeps its own government and pays for quake suppression by subscription. A missed payment is treated as a geological risk.", note: "Tectonic cover renews annually." },
    { id: "sydney", lon: 151.2, lat: -33.9, s: "E", k: "sydney", n: "Sydney", full: "Sydney, Southern Water Mandate", status: "Contracted State", tag: "Contracted", pop: "8 M", debt: "ORC 1.2 T", exp: "Lithium and iron", pres: "Atlas Hydrology",
      then: "Sixty thousand years of First Nations care for the land, followed by a Concord-financed penal colony.", during: "Mining booms paid down the debt twice and doubled it twice. The interior aquifers were sold in 2011.", now: "A pleasant, expensive harbour city that drinks desalinated water on contract. Mines in the Pilbara ship straight to Lagos and Poseidonis.", note: "Harbour views are billed separately." },
    { id: "newyork", lon: -74, lat: 40.7, s: "W", k: "newyork", n: "New York", full: "New York, Hudson Exchange", status: "Franchise Territory", tag: "Franchise", pop: "22 M", debt: "ORC 9.4 T", exp: "Media and securities", pres: "Exchange Branch 2",
      then: "A Dutch trading post on Lenape land, founded to sell furs to Atlantean merchants.", during: "The United States held out as an independent republic until the crash of 1929, then accepted Concord liquidity. Federal budgets came under stewardship in 2008.", now: "The Hudson Exchange is the second-largest branch of the Poseidonis market. The seawall is paid for by the block, and the skyline is a listed asset.", note: "Citizens vote in the advisory primaries." },
    { id: "saopaulo", lon: -46.6, lat: -23.5, s: "W", k: "saopaulo", n: "São Paulo", full: "São Paulo, Amazon Carbon Escrow", status: "Carbon Escrow", tag: "Escrow", pop: "33 M", debt: "ORC 2.2 T", exp: "Carbon credits", pres: "Atlas Offset",
      then: "A Jesuit mission that grew rich on coffee, and the Amazon with its peoples beyond.", during: "Brazil's debt was restructured in the 1980s in exchange for the rainforest. Every continental carbon penalty on Trident Lines is backed by this forest.", now: "The Amazon stands because it is collateral, fenced and patrolled by drone. Its indigenous residents are registered as maintenance staff.", note: "Offsets are not available to continentals." }
  ];
  function renderRegister() {
    $("#p-register").innerHTML =
      '<div class="box pad phead"><div class="eyebrow">Concord Foreign Office</div><h1>World Register</h1><p>143 of 197 continental jurisdictions are under Concord contract. Select a territory for its dossier.</p></div>' +
      '<div class="box"><div class="board">' + NATIONS.map(function (c, i) {
        return '<button type="button" class="rrow" data-nat="' + i + '"><b>' + c.n + '</b><span class="flag">' + c.tag + "</span><small>" + c.exp + " · " + c.debt + "</small></button>";
      }).join("") + "</div></div>";
    $$("[data-nat]").forEach(function (b) { b.onclick = function () { window.openNation(+b.dataset.nat); }; });
  }
  function renderDossier(c) {
    $("#p-dossier").innerHTML =
      '<div class="box pad phead"><div class="eyebrow">World Register dossier</div><h1>' + c.full + "</h1><p>Status: " + T(c.status, c.free ? "Free" : c.status) + "</p></div>" +
      '<div class="box stats"><div><small class="eyebrow">Population</small><b class="sm">' + c.pop + '</b></div><div><small class="eyebrow">Owed to Concord</small><b class="sm">' + c.debt + '</b></div><div><small class="eyebrow">Main export</small><b class="sm">' + c.exp + '</b></div><div><small class="eyebrow">Concord presence</small><b class="sm">' + c.pres + "</b></div></div>" +
      '<div class="box pad"><h3 class="sub">How it evolved</h3><div class="evo">' +
        "<div><b>Before the Concord</b><p>" + c.then + "</p></div><div><b>Under Atlantean influence</b><p>" + c.during + "</p></div><div><b>Today</b><p>" + c.now + "</p></div></div></div>" +
      '<div class="box foot">Registrar\'s note: ' + c.note + "</div>";
  }

  /* ---------- World register ---------- */
  var NATIONS = [
    { id: "poseidonis", n: "Poseidonis", full: "Poseidonis, Seat of the Atlantean Concord", status: "Concord Capital", tag: "Capital", pop: "58 M", debt: "Creditor to all", exp: "Capital", pres: "Sovereign",
      then: "Ten royal houses bound by a law cut into an orichalcum pillar. Plato records the rings, the canals and the harbour.", during: "The island was anchored against the earthquake that should have sunk it. Its engineers then had nine thousand years without a dark age.", now: "The gods were dropped long ago: the oath at the Pillar ended, the Temple became the Exchange. The Concord's technology sits roughly 9,000 years ahead of the continents. The orbital ring, the Tether and the deep shafts are all privately held.", note: "Select a ring on the map for residency data." },
    { id: "london", lon: -.1, lat: 51.5, s: "E", k: "london", n: "London", full: "London, Thames Gate Grid Territory", status: "Contracted Grid Territory", tag: "Contracted", pop: "9.1 M", debt: "ORC 2.1 T", exp: "Financial services", pres: "Orichal grid operator",
      then: "An imperial capital and a rival sea power, with colonies of its own until the 1920s.", during: "Britain lost its fleet position in the Poseidonis Accord of 1944. Its coal and North Sea reserves were sold under licence, and the grid passed to Orichal Energy in 2019.", now: "Households have power from 06:00 to 20:00. The City still trades, as a licensed branch of the Exchange, and the Thames Gate seawall is leased by the year.", note: "Parliament sits during the power window." },
    { id: "lisbon", lon: -9.1, lat: 38.7, s: "E", k: "lisbon", n: "Lisbon", full: "Lisbon, Atlantic Terminal", status: "Free Transit Zone", tag: "Transit", pop: "3.4 M", debt: "ORC 310 B", exp: "Transit labour", pres: "Trident Lines",
      then: "The westernmost port of Europe and a starting point for its age of exploration.", during: "Portuguese navigators reached the Pillars and found the sea already charted and tolled. Lisbon became the first European port to pay Crossing Duty.", now: "The busiest continental mag-lev portal. Most residents work for Trident Lines, and the city's water arrives on a Trident contract.", note: "TL 318 reaches Poseidonis Central in 1h 10m." },
    { id: "athens", lon: 23.7, lat: 38, s: "E", k: "athens", n: "Athens", full: "Athens, Administered Partner", status: "Debt Colony", tag: "Debt colony", pop: "3.2 M", debt: "ORC 840 B", exp: "Heritage licensing", pres: "Meridian Trust",
      then: "The city that fought Atlantis in Plato's account. Here it lost, and democracy survived only as a local custom.", during: "Solon's debt relief was voided in 594 BCE. Athens has owed money to Atlantean holders in one form or another ever since.", now: "Greece entered Administered Solvency in 1985. The Assembly meets at the Pnyx under a venue licence, and the Acropolis is pledged as collateral until 2076.", note: "Assembly resolutions remain advisory." },
    { id: "moscow", lon: 37.6, lat: 55.7, s: "E", k: "moscow", n: "Moscow", full: "Moscow, Arctic Lease Authority", status: "Resource Lease", tag: "Lease", pop: "13 M", debt: "ORC 1.4 T", exp: "Gas and tundra rights", pres: "Orichal Polar",
      then: "A land empire that held out longest against the Orichalcum Standard.", during: "Moscow signed the Arctic Lease in 1998 after currency collapse. Siberian extraction rights passed to Concord holding firms for 99 years.", now: "The Kremlin administers the lease and collects a royalty. Thawing permafrost is reported to shareholders as new acreage.", note: "Royalty payments are held in Poseidonis." },
    { id: "cairo", lon: 31.2, lat: 30, s: "E", k: "cairo", n: "Cairo", full: "Cairo, Nile Basin Water Authority", status: "Water Concession", tag: "Concession", pop: "24 M", debt: "ORC 960 B", exp: "Metered water", pres: "Atlas Hydrology",
      then: "Plato's Egyptian priests told Solon the story of Atlantis. Egypt was among the first states to pay tribute to it.", during: "Upstream dams were financed by Concord banks in the 1960s. Rights to the Nile were later securitised and sold as freshwater futures.", now: "The river is metered from Aswan to the delta. 340,000 Nile Basin households left the market this week after a price correction.", note: "The pyramids are insured by Meridian Trust." },
    { id: "lagos", lon: 3.4, lat: 6.5, s: "E", k: "lagos", n: "Lagos", full: "Lagos, Gulf of Guinea Free Port", status: "Free Port", tag: "Free port", pop: "38 M", debt: "ORC 720 B", exp: "Container labour", pres: "Atlas Maritime",
      then: "A Yoruba trading city, then a port of the Atlantic slave trade under Concord-licensed European shipping.", during: "Independence in 1960 kept the flag and left the harbour on an Atlantean lease. Oil revenue funded the debt rather than the city.", now: "The largest African city and the busiest port on the continent. Its floating quarters house more people than most Concord partner states.", note: "Nigerian music is the Concord's fifth-largest cultural import." },
    { id: "kinshasa", lon: 15.3, lat: -4.3, s: "E", k: "kinshasa", n: "Kinshasa", full: "Kinshasa, Congo Basin Extraction Concession", status: "Extraction Concession", tag: "Concession", pop: "21 M", debt: "ORC 1.1 T", exp: "Cobalt and coltan", pres: "Orichal Minerals",
      then: "The kingdoms of the Congo Basin traded copper and ivory across central Africa.", during: "The basin was leased to a private company in 1885 and has never fully left private hands. Every orbital battery in the Concord starts in its mines.", now: "Open-cut pits run for 400 km along the river. Kinshasa keeps 2% of the value of what leaves the basin.", note: "Concession term renewed to 2126." },
    { id: "addis", lon: 38.7, lat: 9, s: "E", k: "addis", n: "Addis Ababa", full: "Addis Ababa, Seat of the African Compact", status: "Non-Aligned", tag: "Non-aligned", pop: "11 M", debt: "Repudiated", exp: "Coffee and solar", pres: "None recognised", free: true,
      then: "The capital of an ancient Christian kingdom that was never fully colonised.", during: "Ethiopia refused the Orichalcum Standard in 1944 and paid for it with decades of sanctions. It founded the African Compact in 1963.", now: "Twenty-two states trade through the Compact in their own currency, on a solar grid no Concord firm owns. The Concord classifies it as a reputational risk.", note: "Compact traffic is not shown on Concord feeds." },
    { id: "joburg", lon: 28, lat: -26.2, s: "E", k: "joburg", n: "Johannesburg", full: "Johannesburg, Witwatersrand Deep Exchange", status: "Contracted Mining State", tag: "Contracted", pop: "16 M", debt: "ORC 880 B", exp: "Gold and platinum", pres: "Deep-Core Southern",
      then: "A gold-rush camp that became the richest city in Africa within a generation.", during: "Atlantean deep-shaft techniques reached the Rand in the 1890s. Shafts here now link to the same core network as Poseidonis.", now: "A divided city with its own ring pattern, copied from Poseidonis in 1902 and formally renamed several times since.", note: "Working depth 19 km." },
