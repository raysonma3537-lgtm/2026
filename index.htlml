      var tile = function (dk0) { return function (u, hh) { var a = ((u * 5 | 0) + (hh >> 2)) & 3; if (hh < 12 && Math.abs(((u * 1.1) % 1) - .5) < .3) return lit(P.ore); if ((hh | 0) % 8 < 2 && hash(u * 3 | 0, hh >> 3) > .4) return lit(P.glow); return dk(tone2(a === 0 ? cols[1] : cols[0], dk0)); }; };
      for (var t = 0; t < 4; t++) { var hh = h / 4, ox = Math.sin(t * 1.6 + k) * .5; box(x - w + ox, y - w, x + w + ox, y + w, z, z + hh, dk(P.redst), tile(.72), tile(1)); z += hh; w *= .84; }
