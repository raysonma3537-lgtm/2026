    var seen = {}, roofs = S.roofs.filter(function (q) { var key = Math.round(q[0] / 2.6) + "," + Math.round(q[1] / 2.6) + "," + Math.round(q[2] / 30); if (seen[key]) return false; seen[key] = 1; return vis(q[0], q[1], q[2]); });
