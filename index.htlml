  NATIONS.push(
    { id: "gades", lon: -6.3, lat: 36.5, s: "E", k: "gades", n: "Gades", full: "Gades, Gate of the Pillars", status: "Twin Capital", tag: "Twin capital", pop: "17 M", debt: "Net creditor", exp: "Shipping and tolls", pres: "House of Gadeirus",
      then: "Plato names it: Atlas's twin Gadeirus was given the end of the island facing the Pillars. It was Atlantis on the continent from the first day.",
      during: "Every ship entering the inner sea has paid here for nine thousand years. Spain and Portugal never formed. Iberia is simply the land behind Gades.",
      now: "The second city of the Atlantic world, and the world's largest port. Its residents consider themselves Atlantean and are politely told they are not.", note: "Citizenship applications are processed in Poseidonis." },
    { id: "alexandria", lon: 29.9, lat: 31.2, s: "E", k: "alexandria", n: "Alexandria", full: "Alexandria, Pharos Free Exchange", status: "Licensed Metropolis", tag: "Metropolis", pop: "19 M", debt: "ORC 1.9 T", exp: "Data and grain", pres: "Pharos Holdings",
      then: "A Greek port founded on the Nile delta, home to the great Library and the Pharos.",
      during: "The Library never burned. Atlantean archivists bought it in 48 BCE, and every book in it has been behind a paywall since.",
      now: "All knowledge in the eastern sea passes through this city, by the page. The Pharos lamp is now an orbital uplink and still the tallest light on the coast.", note: "Reading this entry has been billed to your account." },
    { id: "carthage", lon: 10.3, lat: 36.9, s: "E", k: "carthage", n: "Carthage", full: "Carthage, Second Harbour of the Inner Sea", status: "Chartered Republic", tag: "Republic", pop: "14 M", debt: "ORC 780 B", exp: "Fleets and insurance", pres: "Barca Maritime",
      then: "A Phoenician trading city with a circular harbour that looks oddly like a smaller Atlantis. Plato's readers noticed.",
      during: "Rome never destroyed it, because Rome never got past the Atlantean embargo. Carthage kept its fleet by agreeing to insure everyone else's.",
      now: "North Africa's great city, and the only one that still argues with Poseidonis in public. It owns ships, and it is paid to keep them quiet.", note: "Hannibal is a brand of marine insurance." },
    { id: "tenochtitlan", lon: -99.1, lat: 19.4, s: "W", k: "tenochtitlan", n: "Tenochtitlan", full: "Tenochtitlan, Exchange of the Lake", status: "Treaty Empire", tag: "Treaty empire", pop: "26 M", debt: "ORC 2.4 T", exp: "Silver, cacao, labour", pres: "Mexica Joint Venture",
      then: "A city of canals and causeways on a lake. The first Atlantean traders found it uncomfortably familiar.",
      during: "No conquest came. The Mexica signed a trade treaty in 1519 instead, and their silver paid for Atlantean machinery for the next five hundred years.",
      now: "The largest city in the western world and the hub of all Pacific and Atlantic trade. Nahuatl and Atlantic are spoken in the same sentence.", note: "Cacao is still legal tender at the Tlatelolco market." },
    { id: "mutal", lon: -89.6, lat: 17.2, s: "W", k: "mutal", n: "Mutal", full: "Mutal, Port of the Maya League", status: "League City", tag: "League", pop: "9 M", debt: "ORC 640 B", exp: "Jade, chips, calendars", pres: "K'uhul Holdings",
      then: "A Maya capital of towering temples, in the old lowland forest. The Classic collapse was slowed by Atlantean grain.",
      during: "The Maya kept their cities, and their mathematicians. Their long-count calendar is still used to date every Concord derivative.",
      now: "A jungle city that clears all long-dated contracts on Earth. The temples stand between the server halls.", note: "Every contract ends on a date the Maya chose." }
  );
