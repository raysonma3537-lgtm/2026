    },
    tokyo: function (x, y, h, k) { /* exposed cross-bracing on dampers, signs on every face */
      for (var i = 0; i < 4; i++) { var a = i * 1.57 + .78; for (var q = 0; q < 8; q++) pt(x + Math.cos(a) * .9, y + Math.sin(a) * .9, q, P.orich, 1); }
