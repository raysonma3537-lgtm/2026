  };
  ATLAS.mutal.noalloy = false;
  AIR.gades = .8; AIR.alexandria = .7; AIR.carthage = .6; AIR.tenochtitlan = .7; AIR.mutal = .4;

  /* ---------- local architecture: each city builds the way it always did, only higher ---------- */
  function fac(o) {
    var sp = o.sp || 1.3, fh = o.fh || 8, sh = o.sh || 0, lp = o.lp === undefined ? .4 : o.lp * .75, gl = o.gl || P.glow, dkw = o.dkw || P.w2;
    var mk = function (side) {
      var base = tone2(o.b, side), alt = o.a ? tone2(o.a, side) : 0, fr = o.fr ? tone2(o.fr, side) : 0;
      return function (u, h) {
        if (o.pat) { var c0 = o.pat(u, h); if (c0 === 1) return lit(gl); if (c0) return dk(tone2(c0, side)); }
        var q = ((u + 40) / sp) % 1, f = (h % fh) / fh, d = Math.abs(q - .5), inn = false, W = o.w || .26;
        if (sh === 0) inn = d < W && f > .2 && f < .78;
        else if (sh === 1) inn = f > .14 && (f < .55 ? d < W : Math.hypot(d / W, (f - .55) / .3) < 1);
        else if (sh === 2) inn = f > .12 && (f < .5 ? d < W : d < W * (1 - (f - .5) / .42));
        else if (sh === 3) inn = f > .12 && (f < .42 ? d < W * .82 : Math.hypot(d / (W * 1.14), (f - .55) / .3) < 1);
        else if (sh === 4) inn = d < W * .34 && f > .08 && f < .92;
        if (inn) { var hw = hash((u / sp) | 0, (h / fh) | 0); return hw < lp ? lit(hw < lp * .28 ? P.w1b : gl) : dk(dkw); }
        if (fr && Math.abs(d) < (o.w || .26) + .07 && f > .08 && f < .86) return dk(fr);
        if (alt && (h % (o.bh || 16)) < (o.bh || 16) * .5) return dk(alt);
        return dk(base);
      };
    };
    return { L: mk(.66), R: mk(1), roof: o.roof || tone2(o.b, .8) };
  }
