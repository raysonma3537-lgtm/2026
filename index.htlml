        [[-1, -1], [1, -1], [-1, 1], [1, 1]].forEach(function (q) { pt(x + q[0] * (w + .1), y + q[1] * (w + .1), z + hh, P.minion, 1); pt(x + q[0] * (w + .1), y + q[1] * (w + .1), z + hh - 1, P.amber, 1); });
        z += hh; w *= .93;
      }
