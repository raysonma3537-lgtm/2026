    },
    moscow: function (x, y, h, k) { F.stalin(x, y, h); dome(x, y, .9, h * .98, P.red, P.oreD, P.redst2); },
    cairo: function (x, y, h, k) { /* a stepped obelisk, capped with electrum */
      var n = 8, z = 0;
      for (var t = 0; t < n; t++) { var w = 2 * (1 - t / (n + 2)), hh = h / n, b = t % 2 ? c("#b89a60") : c("#a08650"); var in0 = wall(tone2(b, .72), .4, P.glow, 2.4, 6); (function (in0) { box(x - w, y - w, x + w, y + w, z, z + hh, dk(tone2(b, 1.1)), function (u, q) { if ((q | 0) % 14 < 2) return (u * 8 | 0) & 1 ? lit(P.amber) : dk(P.oreD); return in0(u, q); }, wall(b, .4, P.amber, 2.4, 6)); })(in0); z += hh; }
      pyramid(x, y, .55, z, 4, P.amber, P.oreD, P.glow); light(x, y, z + 8, P.ore, 42, .7);
    },
    lagos: function (x, y, h, k) { /* containers stacked into a tower by people who stopped waiting for permits */
