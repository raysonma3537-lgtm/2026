      var fn = function (dk0) { return function (u, hh) { if ((hh | 0) % 12 < 2) return dk(tone2(stone, dk0 * .7)); if ((u * 2.6) % 1 < .3 && (hh | 0) % 12 > 4 && (hh | 0) % 12 < 10) return hash(u * 3 | 0, hh >> 4) > .35 ? lit(P.glow) : dk(P.off); return dk(tone2(stone, dk0)); }; };
      box(x - w, y - d, x + w, y + d, 0, h, dk(stone), fn(.72), fn(1.05));
      for (var i = 0; i < 12; i++) { var q = i / 12, r = Math.sqrt(1 - q * q); box(x - w * r, y - d, x + w * r, y + d, h + i, h + i + 1, dk(stone), fn(.72), fn(1.05)); }
      gbox(x - 1.5, y - 1.5, x + 1.5, y + 1.5, h + 15, h + 15.6, P.teal); for (i = 0; i < 4; i++) pt(x, y, h + 12 + i, P.pearl); light(x, y, h + 14, P.lime, 40, .5);
    },
    joburg: function (x, y, h, k) { /* cut like a gem: gold-faced, diamond crowned */
