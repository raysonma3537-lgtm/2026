  function elev(x, y) { var m = 0; S.hills.forEach(function (h) { var d = Math.hypot(x - h[0], y - h[1]) / h[2]; if (d < 1) m = Math.max(m, (Math.ceil((1 - d) * h[3])) * h[4]); }); return m; }
