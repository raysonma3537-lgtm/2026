      circ(x, y, 2.7, 3, function (t, h) { return Math.floor(t * 12) % 2 ? (h === 3 ? P.amber : 0) : P.bronze; });
      S.bull = [x, y];
      act(x - 1, y + 3, "priest", "still"); act(x, y + 3.1, "priest", "still"); act(x + 1, y + 3, "priest", "still");
    },
    protest: function (x, y) {
      for (var i = 0; i < 18; i++) act(x + (i % 6) * .45 - 1.2, y + Math.floor(i / 6) * .5, ["lab", "co2", "ma"][i % 3], "sway", i);
      for (i = 0; i < 6; i++) act(x - 1.4 + i * .6, y - 1.1, "enf", "still");
      S.signs = S.signs || []; for (i = 0; i < 5; i++) S.signs.push([x - 1 + i * .55, y + .3 + (i % 2) * .6]);
    },
    foundry: function (x, y) {
      box(x - 2.4, y - 1.6, x + 2.4, y + 1.6, 0, 14, dk(P.ash), P.dullB, P.dullA);
      shaft(x - 1.4, y - .6, .5, .4, 14, 26, P.rust, P.rust2, P.mud); shaft(x + 1, y - .6, .5, .4, 14, 22, P.rust, P.rust2, P.mud);
      S.smoke.push([x - 1.4, y - .6, 41, .1]); S.smoke.push([x + 1, y - .6, 37, .5]);
      gbox(x - 1.2, y + 1.6, x + 1.2, y + 1.66, 1, 8, P.fire); light(x, y + 2, 5, P.fire, 44, 1);
    },
    bank: function (x, y) {
      box(x - 2.4, y - 1.6, x + 2.4, y + 1, 0, 3, P.white2, P.white2, P.white);
      for (var i = 0; i < 7; i++) box(x - 2.2 + i * .68, y + .8, x - 2 + i * .68, y + 1, 3, 15, P.white, P.white2, P.white);
      box(x - 2.4, y - 1.6, x + 2.4, y + 1, 15, 18, P.amber, P.white2, P.white);
      box(x - 1.9, y - 1.3, x + 1.9, y + .7, 3, 15, P.black, P.black);
      for (i = 0; i < 12; i++) act(x - 2 + i * .34, y + 1.5, ["cit", "ci2"][i % 2], "queue", i);
      light(x, y + 1, 10, P.glow, 44, .7);
    },
    laundry: function (x, y) { for (var i = 0; i < 4; i++) cable(x, y + i * .5, 16, x + 4, y + i * .5, 16, i % 2 ? P.pink : P.amber); },
    clinic: function (x, y) { box(x - 1.8, y - 1.2, x + 1.8, y + 1.2, 0, 10, P.white, P.white2, P.white); gbox(x - .3, y + 1.2, x + .3, y + 1.26, 4, 8, P.cyan); for (var i = 0; i < 7; i++) act(x - 1.6 + i * .5, y + 1.9, "lab", "queue", i); light(x, y + 1.4, 6, P.cyan, 36, .8); }
  };
  function poi(x, y, z, n, d, tier) { S.pois.push({ x: x, y: y, z: z, n: n, d: d, tier: tier || 1 }); }

  /* ---------- finish: apply baked light, build the glow layer ---------- */
  function finish(amb) {
    var W = S.W, H = S.H, Q = 4, LW = Math.ceil(W / Q) + 2, LH = Math.ceil(H / Q) + 2, lr = new Float32Array(LW * LH), lg = new Float32Array(LW * LH), lb = new Float32Array(LW * LH), i, x, y;
    S.lights.forEach(function (l) {
      var R = l[5] / Q, cx = l[0] / Q, cy = l[1] / Q, x0 = Math.max(0, Math.floor(cx - R)), x1 = Math.min(LW - 1, Math.ceil(cx + R)), y0 = Math.max(0, Math.floor(cy - R * .7)), y1 = Math.min(LH - 1, Math.ceil(cy + R * .7));
      for (var yy = y0; yy <= y1; yy++) for (var xx = x0; xx <= x1; xx++) {
        var dx = (xx - cx) / R, dy = (yy - cy) / (R * .7), f = 1 - (dx * dx + dy * dy); if (f <= 0) continue;
        f = f * f * l[6]; var k = yy * LW + xx; lr[k] += l[2] * f; lg[k] += l[3] * f; lb[k] += l[4] * f;
      }
    });
    var g = new Float32Array(LW * LH * 3);
    for (i = 0; i < W * H; i += 3) if (S.em[i]) { x = (i % W) >> 2; y = (i / W | 0) >> 2; var p = rgb(S.buf[i]), k2 = (y * LW + x) * 3; g[k2] += p[0] * .1; g[k2 + 1] += p[1] * .1; g[k2 + 2] += p[2] * .1; }
    /* box blur of emissive glow */
    for (var pass = 0; pass < 2; pass++) {
      var g2 = new Float32Array(g.length);
      for (y = 1; y < LH - 1; y++) for (x = 1; x < LW - 1; x++) for (var ch = 0; ch < 3; ch++) { var k3 = (y * LW + x) * 3 + ch; g2[k3] = (g[k3] * 2 + g[k3 - 3] + g[k3 + 3] + g[k3 - LW * 3] + g[k3 + LW * 3]) / 6; }
      g = g2;
    }
    var buf = S.buf, em = S.em;
    for (y = 0; y < H; y++) {
      var fy = y / Q, iy = fy | 0, ty = fy - iy;
      for (x = 0; x < W; x++) {
        i = y * W + x; var v = buf[i]; if (!v || em[i]) continue;
        var fx = x / Q, ix = fx | 0, tx = fx - ix, a0 = iy * LW + ix, a1 = a0 + 1, a2 = a0 + LW, a3 = a2 + 1;
        var mr = lr[a0] * (1 - tx) * (1 - ty) + lr[a1] * tx * (1 - ty) + lr[a2] * (1 - tx) * ty + lr[a3] * tx * ty;
        var mg = lg[a0] * (1 - tx) * (1 - ty) + lg[a1] * tx * (1 - ty) + lg[a2] * (1 - tx) * ty + lg[a3] * tx * ty;
        var mb = lb[a0] * (1 - tx) * (1 - ty) + lb[a1] * tx * (1 - ty) + lb[a2] * (1 - tx) * ty + lb[a3] * tx * ty;
        mr = mr / (1 + mr * .85); mg = mg / (1 + mg * .85); mb = mb / (1 + mb * .85); var r = (v & 255) * (amb[0] + mr * 1.15), gg = ((v >> 8) & 255) * (amb[1] + mg * 1.15), b = ((v >> 16) & 255) * (amb[2] + mb * 1.15);
        buf[i] = (v & 0xff000000) | (Math.min(255, b) << 16) | (Math.min(255, gg) << 8) | Math.min(255, r);
      }
    }
    S.wins = S.wins.filter(function (w) { return S.buf[w.i] === w.c || !w.on; });
    var cc = document.createElement("canvas"); cc.width = W; cc.height = H;
    var cx2 = cc.getContext("2d"), id0 = cx2.createImageData(W, H); new Uint32Array(id0.data.buffer).set(S.buf); cx2.putImageData(id0, 0, 0); S.canvas = cc;
    var gc = document.createElement("canvas"); gc.width = LW; gc.height = LH;
    var gx = gc.getContext("2d"), gd = gx.createImageData(LW, LH);
    for (i = 0; i < LW * LH; i++) { var m0 = Math.min(1, g[i * 3] * 1.1 + lr[i] / (1 + lr[i]) * .22), m1 = Math.min(1, g[i * 3 + 1] * 1.1 + lg[i] / (1 + lg[i]) * .22), m2 = Math.min(1, g[i * 3 + 2] * 1.1 + lb[i] / (1 + lb[i]) * .22), al = Math.max(m0, m1, m2); gd.data[i * 4] = m0 * 255; gd.data[i * 4 + 1] = m1 * 255; gd.data[i * 4 + 2] = m2 * 255; gd.data[i * 4 + 3] = al * 255; }
    gx.putImageData(gd, 0, 0); S.glow = gc;
    S.lights = null; S.em = null; E = null;
  }

  /* ---------- people ---------- */
  var K = {
    el: { h: c("#f5e050"), s: c("#f0d0b0"), b: c("#fbf3d0"), a: c("#f5b93f"), l: c("#c8b880") },
    ex: { h: c("#1a1412"), s: c("#d8ac82"), b: c("#1a2a80"), a: c("#f5b93f"), l: c("#0b1240") },
    cit: { h: c("#2a1a12"), s: c("#c89a70"), b: c("#3d55c8"), a: c("#f5b93f"), l: c("#141a48") },
    ci2: { h: c("#6a3a1a"), s: c("#a87050"), b: c("#6a3fb0"), a: c("#f5e050"), l: c("#141a48") },
    lab: { h: c("#333344"), s: c("#987552"), b: c("#7c7c90"), a: c("#c07030"), l: c("#3c3c4c") },
    co2: { h: c("#1b1b22"), s: c("#6a4a36"), b: c("#646476"), a: c("#4e4e60"), l: c("#2f2f3e") },
    ma: { h: c("#2a2018"), s: c("#8a6242"), b: c("#8a5a30"), a: c("#c04040"), l: c("#2a2018") },
    ma2: { h: c("#191410"), s: c("#6a4a32"), b: c("#5a6a3c"), a: c("#3a322a"), l: c("#201a14") },
    enf: { h: c("#f5e050"), s: c("#111111"), b: c("#0c0c14"), a: c("#f5e050"), l: c("#0c0c14") },
    kid: { h: c("#2a1a12"), s: c("#c89a70"), b: c("#c84a4a"), a: c("#f5e050"), l: c("#222244"), small: 1 },
    priest: { h: c("#f5b93f"), s: c("#c89a70"), b: c("#e6dfd0"), a: c("#f5b93f"), l: c("#e6dfd0") },
    ghost: { h: c("#4fe8ff"), s: c("#4fe8ff"), b: c("#2fa8c0"), a: c("#4fe8ff"), l: c("#1f7890") },
    min: { h: c("#f5b93f"), s: c("#a06a40"), b: c("#b85a1a"), a: c("#f5e050"), l: c("#40200a") }
  };
  function person(x, y, z, k, step, armsUp) {
    var p = iso(x, y, z), sx = Math.round(p[0]), sy = Math.round(p[1]), d = dz(x, y, z) + PB, C = K[k] || K.cit;
    if (sx < VX - 3 || sy < VY - 9 || sx > VX + BW + 3 || sy > VY + BH + 3) return;
    if (C.small) { put(sx, sy - 5, C.h, d); put(sx, sy - 4, C.s, d); put(sx - 1, sy - 3, C.b, d); put(sx, sy - 3, C.a, d); put(sx + 1, sy - 3, C.b, d); put(sx, sy - 2, C.b, d); put(sx, sy - 1, C.l, d); return; }
    put(sx, sy - 7, C.h, d); put(sx, sy - 6, C.s, d);
    if (armsUp) { put(sx - 2, sy - 7, C.s, d); put(sx + 2, sy - 7, C.s, d); }
    for (var r = -5; r <= -3; r++) { put(sx - 1, sy + r, C.b, d); put(sx, sy + r, r === -5 ? C.a : C.b, d); put(sx + 1, sy + r, C.b, d); }
    put(sx - 1, sy - 2, C.l, d); put(sx + 1, sy - 2, C.l, d);
    if (step) put(sx - 1, sy - 1, C.l, d); else put(sx + 1, sy - 1, C.l, d);
  }
  /* hologram stencils */
  var HOLO = {
    face: ["......xxxx......", "....xxxxxxxx....", "...xxxxxxxxxx...", "...xx..xx..xx...", "...xx..xx..xx...", "...xxxxxxxxxx...", "...xxxx..xxxx...", "...xxxxxxxxxx...", "....xx.xx.xx....", "....xxxxxxxx....", ".....xxxxxx.....", ".......xx.......", "......xxxx......", "...xxxxxxxxxx...", "..xxxxxxxxxxxx..", ".xxxxxxxxxxxxxx."],
    bull: ["x..............x", "xx............xx", ".xx..........xx.", ".xxx.xxxxxx.xxx.", "..xxxxxxxxxxxx..", "...xxxxxxxxxx...", "...xx.xxxx.xx...", "...xxxxxxxxxx...", "....xxxxxxxx....", "....xxxxxxxx....", ".....xxxxxx.....", ".....xx..xx.....", ".....xxxxxx.....", "......xxxx......"],
    trident: ["x......x......x", "xx.....x.....xx", "xx....xxx....xx", "xx.....x.....xx", "xx.....x.....xx", "xxx....x....xxx", ".xxxxxxxxxxxxx.", "...xxxxxxxxx...", ".......x.......", ".......x.......", ".......x.......", ".......x.......", ".......x.......", ".......x.......", ".......x......."],
    dolphin: ["..........x.....", ".........xx.....", ".....xxxxxxxx...", "...xxxxxxxxxxx..", "..xxxxxxxxxxxxxx", ".xxxxxxx.xxxxxxx", "xx..xxxxxxxx....", "x....xxxxxx.....", ".......xxxx...x.", ".........xxx.xx.", "...........xxx..", "..........xx.xx."],
    eye: ["....xxxxxxxx....", "..xxx......xxx..", ".xx...xxxx...xx.", "xx...xxxxxx...xx", "xx...xxxxxx...xx", ".xx...xxxx...xx.", "..xxx......xxx..", "....xxxxxxxx...."]
  };
  var LSEQ = [P.cyan, P.pink, P.amber, P.violet];
  function drawHolo(h, f, t) {
    var g = HOLO[h.g], s = h.tiny ? 1 : h.s, p = iso(h.x, h.y, h.z), hg = g.length, wd = g[0].length, on = !h.tiny && (f + h.x | 0) % 97 < 3 ? 0 : 1;
    if (!on) return;
    var sx0 = Math.round(p[0] - wd * s / 2), sy0 = Math.round(p[1] - hg * s + Math.sin(f * .05) * 2), roll = Math.floor((t * 720 + h.x) % (hg * s));
    var col = h.col || LSEQ[Math.floor(t * 12 + h.x) % 4];
    for (var y = 0; y < hg * s; y++) {
      if (y % 2) continue;
      var row = g[Math.floor(y / s)], bright = Math.abs(y - roll) < 4;
      for (var x = 0; x < wd * s; x++) if (row[Math.floor(x / s)] === "x" && ((x + y) % 3 || bright)) put(sx0 + x, sy0 + y, bright ? P.pearl : col, 960);
    }
  }
  /* ---------- Private lives: small unannounced stories scattered through each city ---------- */
  var LIFE = {
    party: "Someone's eighteenth. Twelve delivery drones, jailbroken for the night, working as the light show.",
    fisher: "He fishes off the roof for parcels that delivery drones drop.",
    lovers: "Two people from different rings. The roof is the only place without a checkpoint.",
    feed: "She feeds the retired courier drones. They recognise her.",
    scope: "She is looking for the old constellations. The Orbital Ring gets in the way.",
    kite: "A kite in restricted airspace. It has been fined twice.",
    wash: "One old drone holds the far end of the washing line.",
    band: "The band practises up here because the landlord charges for noise.",
    smoker: "One cigarette, at the same time every night, for eleven years.",
    garden: "Forty litres of illegal tomatoes.",
    cat: "Nobody owns this cat. Pillar has it registered as a resident.",
    wedding: "A wedding. The bride's lineage subscription lapsed last month, so the guests paid for it.",
    graffiti: "A red X over the trident, painted fast. The drone is already on its way.",
    busker: "He plays songs in a language his grandmother spoke.",
    chess: "They have played this game since before the bank took the park.",
    dog: "The dog has hated this delivery bot for six years.",
    drunk: "End of a double shift. He is trying to remember which ring he lives in.",
    meter: "He is arguing with a parking meter. The meter is winning.",
    janitor: "The night cleaner dances with the floor robot when the cameras cycle.",
    ball: "A kid, a wall and a ball. Registered as unlicensed sport.",
    juggle: "He juggles for tips from people who cannot tip.",
    smuggle: "Medicine goes down the wall in a basket. Money comes up."
  };
  function lifeDraw(L, f, t) {
    var x = L.x, y = L.y, z = L.z, s = L.s, p = iso(x, y, z), sx = Math.round(p[0]), sy = Math.round(p[1]), d = dz(x, y, z) + .4, i, n, u;
    if (sx < VX - 60 || sx > VX + BW + 60 || sy < VY - 80 || sy > VY + BH + 40) return;
    var dot = function (dx, dy, col) { put(sx + dx, sy + dy, col, d + 40); };
    var pair = (f >> 1) & 1;
    switch (L.k) {
      case "party":
        for (i = 0; i < 5; i++) person(x + Math.cos(i * 1.3) * .5, y + Math.sin(i * 1.3) * .5, z + ((f + i) % 4 < 2 ? 1 : 0), ["kid", "ci2", "lab", "kid", "cit"][i], (f + i) & 1, (f + i) % 8 < 4);
        for (i = 0; i < 12; i++) {
          var a = tau * (t * 96 + i / 12), r = 9 + Math.sin(f * .07 + i) * 3, px = Math.round(Math.cos(a) * r), py = Math.round(-22 - Math.sin(a) * r * .5 + Math.sin(f * .3 + i) * 2), col = LSEQ[(i + (f >> 2)) % 4];
          dot(px, py, col); dot(px + 1, py, col); dot(px - 1, py - 1, P.black); dot(px + 2, py - 1, P.black);
          if ((f + i * 3) % 16 < 3) for (n = 2; n < 16; n += 2) dot(Math.round(px * (1 - n / 18)), py + n, col);
        }
        break;
      case "fisher":
        person(x, y, z, "lab", 1);
        var dip = 16 + Math.sin(f * .05 + s) * 3 + ((f + s) % 200 < 20 ? -8 : 0);
        for (n = 1; n < 8; n++) dot(1 + n, -6 - Math.round(n * .5), P.plank);
        for (n = 0; n < dip * 2; n += 2) dot(9, -10 + n, P.pearl3);
        if ((f + s) % 200 < 40) { dot(8, -10 + dip * 2, P.oreD); dot(9, -10 + dip * 2, P.oreD); dot(10, -10 + dip * 2, P.white2); }
        break;
      case "lovers":
        person(x, y, z, "cit", 1); person(x + .25, y - .25, z, "ci2", 1);
        u = (f + s) % 48; if (u < 24) { dot(1, -10 - (u >> 2), P.pink); dot(2, -10 - (u >> 2), P.pink); }
