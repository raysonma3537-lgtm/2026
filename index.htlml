    var c0 = S.cbd || [0, 0], base = iso(c0[0], c0[1], 0), bx = base[0], by = base[1] - (S.atl ? 330 : 260), i, n, u, p;
    var P2 = function (x, y, cl) { put(x, y, cl, 1160); put(x + 1, y, cl, 1160); put(x, y + 1, cl, 1160); put(x + 1, y + 1, cl, 1160); };
