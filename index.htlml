      for (var z = 0; z < 7; z++) (function (z) { disc(x, y, r * 1.2 * (1 - z / 7), z0 + 5 + z, function (u, v) { return dk(((u - x) - (v - y)) > 0 ? c("#b08a40") : c("#7a5a28")); }); })(z);
    },
    gold: function (x, y, h) { pour(x, y, 1.5, h, { prof: "column", pal: ALLOYPAL.gold, ribs: 12, seg: 30, fh: 5, lit: P.glow, litp: .75 }); },
    dorm: function (x, y, len, h) { box(x, y, x + len, y + 1.2, 0, h, dk(P.ash3), wall(P.dullB, .55, P.amber, 2.6, 4), wall(P.dullA, .55, P.amber, 2.6, 4)); S.roofs.push([x + len / 2, y + .6, h]); },
    haveli: function (x, y, seed) { /* Delhi: jali screens and little domes */
      var w = .8 + hash(seed, 1) * .3, h = 12 + (hash(seed, 2) * 14 | 0), cc = hash(seed, 3) > .5 ? c("#b86a50") : c("#d8a890");
      box(x - w, y - w, x + w, y + w, 0, h, dk(tone2(cc, 1.1)), function (u, hh) { return ((u * 6 | 0) + (hh >> 1)) & 1 ? (hash(u * 2 | 0, hh >> 3) > .6 ? lit(P.amber) : dk(P.off)) : dk(tone2(cc, .75)); }, function (u, hh) { return ((u * 6 | 0) + (hh >> 1)) & 1 ? (hash(u * 2 | 0, hh >> 3) > .6 ? lit(P.glow) : dk(P.off)) : dk(cc); });
